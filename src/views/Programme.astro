---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Clouds from "../components/Clouds.astro";
import Icon from "../components/Icon.astro";
import SpeakerCard from "../components/SpeakerCard.astro";
import { speakersFor } from "../data/speakers";
import { programme, sessionKindLabel } from "../data/programme";
import { editionBySlug, nextEdition } from "../data/editions";
import { isUpcoming, localePath } from "../i18n";
import { formatDate, formatRange, formatTime, t, type Lang } from "../i18n";
import { eventLd } from "../lib/schema";
import { festivalSocial } from "../site.config";
import { coverFor, focusOf } from "../data/gallery";
import type { SessionKind } from "../data/programme";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const hi = lang === "hi";
const site = Astro.site!;
const e = editionBySlug(programme.editionSlug)!;
const when = formatRange(e, lang);
const title = hi
  ? `आयोजन: किताब उत्सव ${e.city.hi} ${e.year} | दिन-वार सत्र`
  : `Events: Kitab Utsav ${e.city.en} ${e.year} | Day-wise sessions`;
const description = hi
  ? `किताब उत्सव ${e.city.hi} (${when}) का दिन-वार कार्यक्रम: उद्घाटन, बातचीत, लोकार्पण, चर्चा, पाठ और काव्य संध्या। ${e.venue?.hi ?? ""}`
  : `Day-wise programme for Kitab Utsav ${e.city.en} (${when}): opening, conversations, book launches, discussions, readings and poetry. ${e.venue?.en ?? ""}`;
const crumbs = [{ name: s.nav.programme, path: "/programme/" }];
const announced = speakersFor(e.slug);
const up = isUpcoming(e);

/* Sessions only become structured data once the real schedule is published. */
const ev = up ? eventLd(e, lang, site, "/og/kitab-utsav.jpg") : null;
const jsonLd: Record<string, unknown>[] = [];
if (ev) {
  if (programme.published) {
    (ev as Record<string, unknown>).subEvent = programme.days.flatMap((d) =>
      d.sessions
        .filter((x) => x.kind !== "exhibition")
        .map((x) => ({
          "@type": "Event",
          name: x.title[lang],
          startDate: `${d.date}T${x.time}:00+05:30`,
          eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
          eventStatus: "https://schema.org/EventScheduled",
          location: (ev as { location: unknown }).location,
          ...(x.speakers.length ? { performer: x.speakers.map((n) => ({ "@type": "Person", name: n })) } : {}),
        })),
    );
  }
  jsonLd.push(ev);
}

// Colour per kind of session, and the kinds this programme uses (for the legend).
const kindTone: Record<SessionKind, string> = {
  exhibition: "sand", opening: "red", conversation: "blue", launch: "saffron",
  discussion: "sky", reading: "lilac", poetry: "lime", performance: "navy",
};
const kinds = [...new Set(programme.days.flatMap((d) => d.sessions.map((x) => x.kind)))];
const nx = nextEdition && nextEdition.slug !== e.slug ? nextEdition : null;
const nxCover = nx ? coverFor(nx.slug) : undefined;
const dated = !!(nx?.start && nx.end);
const weekday = (iso: string) => new Intl.DateTimeFormat(hi ? "hi-IN" : "en-IN", { weekday: "short", timeZone: "Asia/Kolkata" }).format(new Date(`${iso}T12:00:00+05:30`));
const dayNum = (iso: string) => String(Number(iso.slice(8, 10)));
const month = (iso: string) => new Intl.DateTimeFormat(hi ? "hi-IN" : "en-IN", { month: "short", timeZone: "Asia/Kolkata" }).format(new Date(`${iso}T12:00:00+05:30`));
---

<Base lang={lang} route="/programme/" title={title} description={description} crumbs={crumbs} jsonLd={jsonLd}>
  <section class="page-hero ev-hero">
    <Clouds items={[{ x: "62%", y: "-10%", w: 240 }, { x: "90%", y: "50%", w: 170, flip: true }]} />
    <div class="wrap">
      <Crumbs lang={lang} items={crumbs} />
      <p class="eyebrow">{hi ? "आयोजन" : "Events"}</p>
      <h1>{hi ? <>उत्सव का <em>दिन-वार</em> कार्यक्रम</> : <>The festival, <em>day by day</em></>}</h1>
      {nx && (
        <a class="ev-next" href={localePath(lang, `/editions/${nx.slug}/`)}>
          <span class="ev-next__photo" aria-hidden="true">{nxCover && <img src={nxCover.src} alt="" decoding="async" style={`object-position:${focusOf(nxCover)}`} />}</span>
          <span class="ev-next__body">
            <span class="ev-next__kick"><i aria-hidden="true"></i>{hi ? "अगला पड़ाव" : "Next stop"}</span>
            <b class="ev-next__city">{hi ? `किताब उत्सव ${nx.city.hi}` : `Kitab Utsav ${nx.city.en}`}</b>
            <span class="ev-next__when">{formatRange(nx, lang)}{nx.venue ? ` · ${nx.venue[lang].split(",")[0]}` : (hi ? " · स्थान की घोषणा जल्द" : " · venue to be announced")}</span>
            <span class="ev-next__note">{dated ? (hi ? "कार्यक्रम घोषणा के साथ यहीं आएगा।" : "Its programme will appear here once announced.") : (hi ? "तारीख़ें और कार्यक्रम घोषणा के साथ यहीं आएँगे।" : "Dates and programme will appear here once announced.")}</span>
          </span>
          <span class="ev-next__go" aria-hidden="true"><Icon name="arrowUpRight" /></span>
        </a>
      )}
      <div class="ev-hero__ctas">
        <a class="btn btn--red" href={festivalSocial[0].url} target="_blank" rel="noopener"><Icon name="Instagram" size={20} />{hi ? "ख़बर सबसे पहले पाएँ" : "Hear about it first"}</a>
        {dated && <a class="btn btn--line btn--line-dark" href={`/ics/${nx!.slug}.ics`} download><Icon name="calendar" size={20} />{s.addToCal}</a>}
      </div>
    </div>
  </section>

  <section class="section ev-plan" aria-labelledby="plan-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{up ? (hi ? "आगामी" : "Coming up") : (hi ? "पिछला कार्यक्रम" : "Last programme")}</p>
          <h2 class="h2" id="plan-h">{hi ? `किताब उत्सव ${e.city.hi} ${e.year}` : `Kitab Utsav ${e.city.en} ${e.year}`}</h2>
          <p class="lead">{e.venue?.[lang].split(",")[0]} · {when} · {hi ? `रोज़ ${formatTime(e.startTime!, "hi")} से ${formatTime(e.endTime!, "hi")}` : `daily ${formatTime(e.startTime!, "en")} to ${formatTime(e.endTime!, "en")}`}</p>
        </div>
      </div>
      {(!up || !programme.published) && (
        <p class="ev-note" role="note">
          <Icon name="help" />
          <span>
            {!up
              ? (hi ? <>यह उत्सव पूरा हो चुका है; नीचे उसका दिन-वार ढाँचा है। <a href={localePath(lang, `/editions/${e.slug}/`)}>{e.city.hi} की झलकियाँ देखें</a>।</> : <>This festival has ended; below is its day-wise outline. <a href={localePath(lang, `/editions/${e.slug}/`)}>See the {e.city.en} recap</a>.</>)
              : (hi ? <>सत्रों और वक्ताओं की घोषणा जल्द होगी; ताज़ा जानकारी <a href={festivalSocial[0].url} target="_blank" rel="noopener">{festivalSocial[0].handle}</a> पर।</> : <>Sessions and speakers will be announced soon; for the latest, follow <a href={festivalSocial[0].url} target="_blank" rel="noopener">{festivalSocial[0].handle}</a>.</>)}
          </span>
        </p>
      )}

      <div class="ev-planner" data-tabs data-planner>
        <div class="ev-days" role="tablist" aria-label={hi ? "दिन चुनें" : "Choose a day"}>
          {programme.days.map((d, i) => (
            <button type="button" class="ev-day" role="tab" id={`tab-${d.date}`} aria-controls={`day-${d.date}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-date={d.date}>
              <span class="ev-day__n">{hi ? `दिन ${i + 1}` : `Day ${i + 1}`}</span>
              <b class="ev-day__d">{dayNum(d.date)}</b>
              <span class="ev-day__m">{month(d.date)} · {weekday(d.date)}</span>
              <span class="ev-day__count">{hi ? `${d.sessions.length} सत्र` : `${d.sessions.length} sessions`}</span>
            </button>
          ))}
        </div>

        <div class="ev-legend" role="group" aria-label={hi ? "सत्र का प्रकार चुनें" : "Highlight a kind of session"}>
          {kinds.map((k) => <button type="button" class="ev-key" data-kind={k} aria-pressed="false" style={`--tone:var(--${kindTone[k]})`}><i aria-hidden="true"></i>{sessionKindLabel[k][lang]}</button>)}
        </div>

        {programme.days.map((d, i) => (
          <section class="ev-panel" id={`day-${d.date}`} role="tabpanel" aria-labelledby={`tab-${d.date}`} data-date={d.date}>
            <h3 class="sr">{hi ? `दिन ${i + 1}: ` : `Day ${i + 1}: `}{formatDate(d.date, lang, true)}</h3>
            <ol class="ev-line">
              {d.sessions.map((x) => {
                const tba = !x.speakers.length && x.kind !== "exhibition" && x.kind !== "opening" && x.kind !== "poetry";
                return (
                  <li class:list={["ev-s", `ev-s--${x.kind}`, { "is-tba": tba }]} data-kind={x.kind} data-start={x.time} data-end={x.end ?? ""} style={`--tone:var(--${kindTone[x.kind]})`}>
                    <time class="ev-s__t" datetime={`${d.date}T${x.time}`}>{formatTime(x.time, lang)}{x.end && <small>{hi ? "से " : "to "}{formatTime(x.end, lang)}</small>}</time>
                    <span class="ev-s__dot" aria-hidden="true"></span>
                    <div class="ev-s__card">
                      <span class="ev-s__kind">{sessionKindLabel[x.kind][lang]}</span>
                      <h4>{x.title[lang]}</h4>
                      {x.speakers.length > 0 && <p class="ev-s__who">{x.speakers.join(", ")}</p>}
                      {x.end && <p class="ev-s__who">{hi ? "पूरे दिन खुली" : "Open all day"}</p>}
                    </div>
                  </li>
                );
              })}
            </ol>
          </section>
        ))}
      </div>
    </div>
  </section>

  {announced.length > 0 && (
    <section class="section ev-people" aria-labelledby="speakers">
      <div class="wrap">
        <div class="section-head"><div><p class="eyebrow">{hi ? `किताब उत्सव ${e.city.hi} में` : `At Kitab Utsav ${e.city.en}`}</p><h2 class="h2" id="speakers">{hi ? "मंच पर" : "On stage"}</h2></div></div>
        <div class="grid grid--3">{announced.map((sp) => <SpeakerCard s={sp} lang={lang} />)}</div>
      </div>
    </section>
  )}
</Base>
