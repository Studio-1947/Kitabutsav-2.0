---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Clouds from "../components/Clouds.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import { editions } from "../data/editions";
import { galleryFor, hasRealPhotos } from "../data/gallery";
import { festivalSocial } from "../site.config";
import { formatRange, localePath, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const hi = lang === "hi";
const title = hi ? "गैलरी: किताब उत्सव की तस्वीरें, शहर दर शहर" : "Gallery: Kitab Utsav in pictures, city by city";
const description = hi
  ? "किताब उत्सव के हर संस्करण की तस्वीरें: उद्घाटन, बातचीत, लोकार्पण, पुस्तक प्रदर्शनी और पाठक।"
  : "Photos from every Kitab Utsav edition: openings, conversations, book launches, the book exhibition and readers.";
const crumbs = [{ name: hi ? "गैलरी" : "Gallery", path: "/gallery/" }];
const withPhotos = editions.filter((e) => galleryFor(e.slug).length);
---
<Base lang={lang} route="/gallery/" title={title} description={description} crumbs={crumbs}>
  <section class="page-hero">
    <Clouds items={[{ x: "70%", y: "-10%", w: 260 }, { x: "88%", y: "45%", w: 180, flip: true }]} />
    <div class="wrap">
      <Crumbs lang={lang} items={crumbs} />
      <p class="eyebrow">{hi ? "गैलरी" : "Gallery"}</p>
      <h1>{hi ? <>शहर दर शहर, <em>तस्वीरों में</em></> : <>City by city, <em>in pictures</em></>}</h1>
      <p class="lead">
        {hi
          ? "हर पड़ाव के कुछ पल: मंच, प्रदर्शनी, लोकार्पण और वे पाठक जिनके लिए यह उत्सव है।"
          : "Moments from every stop: the stage, the exhibition, the launches, and the readers the festival is for."}
      </p>
    </div>
  </section>

  <nav class="chips wrap" aria-label={hi ? "संस्करण चुनें" : "Jump to an edition"}>
    {withPhotos.map((e) => <a class="chip" href={`#${e.slug}`}>{e.city[lang]} {e.year}</a>)}
  </nav>

  <section class="section" style="padding-top:28px">
    <div class="wrap">
      {!hasRealPhotos && (
        <div class="notice" role="note">
          <p>
            {hi ? "तस्वीरें जोड़ी जा रही हैं। तब तक उत्सव की झलकियाँ " : "Photos are being added. Until then, see festival moments on "}
            <a href={festivalSocial[0].url} target="_blank" rel="noopener" style="text-decoration:underline">{festivalSocial[0].handle}</a>
            {hi ? " पर देखें।" : "."}
          </p>
        </div>
      )}
      {withPhotos.map((e) => (
        <section class="gallery-block" id={e.slug} aria-labelledby={`g-${e.slug}`}>
          <div class="gallery-block__head">
            <h2 id={`g-${e.slug}`}>{e.city[lang]} <span>{e.year}</span></h2>
            <p>{formatRange(e, lang)}{e.venue && ` · ${e.venue[lang]}`}</p>
            <a class="link-more" href={localePath(lang, `/editions/${e.slug}/`)}>{s.exploreDetails}</a>
          </div>
          <GalleryGrid items={galleryFor(e.slug)} lang={lang} />
        </section>
      ))}
    </div>
  </section>
</Base>
