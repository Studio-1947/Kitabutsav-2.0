---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Clouds from "../components/Clouds.astro";
import Icon from "../components/Icon.astro";
import { coverage, pressContact } from "../data/press";
import { editions, editionBySlug } from "../data/editions";
import { festivalTotals, tagline, hashtag, allSpeakers } from "../data/speakers";
import { partners } from "../data/partners";
import { coverFor } from "../data/gallery";
import { formatDate, formatRange, localePath, t, type Lang } from "../i18n";
import { org } from "../site.config";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const hi = lang === "hi";
const title = hi ? "मीडिया और प्रेस: किताब उत्सव की ख़बरें और प्रेस किट" : "Press and media: Kitab Utsav coverage and press kit";
const description = hi
  ? "किताब उत्सव पर प्रेस कवरेज, तथ्य-पत्र, लोगो और मीडिया संपर्क।"
  : "Press coverage of Kitab Utsav, a fact sheet, logos and media contacts.";
const crumbs = [{ name: hi ? "मीडिया" : "Press", path: "/press/" }];
const dated = editions.filter((e) => e.start);
const first = dated[dated.length - 1];
const facts = hi
  ? [
      ["नाम", "किताब उत्सव (Kitab Utsav)"],
      ["आयोजक", "राजकमल प्रकाशन समूह: राजकमल, राधाकृष्ण, लोकभारती, राजकमल उर्दू"],
      ["स्वरूप", "घूमता हुआ हिन्दी पुस्तक उत्सव; हर पड़ाव आम तौर पर पाँच दिन"],
      ["शुरुआत", "भोपाल, राजकमल प्रकाशन के 75वें वर्ष में"],
      ["अब तक", festivalTotals.map((x) => `${x.value} ${x.label.hi}`).join(" · ")],
      ["नारा", `${tagline.hi} ${hashtag}`],
    ]
  : [
      ["Name", "Kitab Utsav (किताब उत्सव)"],
      ["Organiser", "Rajkamal Prakashan Samuh: Rajkamal, Radhakrishna, Lokbharti, Rajkamal Urdu"],
      ["Format", "Travelling Hindi book festival; each stop usually runs five days"],
      ["Began", "Bhopal, in Rajkamal Prakashan's 75th year"],
      ["So far", festivalTotals.map((x) => `${x.value} ${x.label.en}`).join(" · ")],
      ["Line", `${tagline.en} ${hashtag}`],
    ];
const assets = [
  { href: "/brand/kitab-utsav-logo.svg", label: hi ? "किताब उत्सव लोगो" : "Kitab Utsav logo", type: "SVG", size: "58 KB", bg: "#fff" },
  { href: "/brand/rkp-logo.svg", label: hi ? "राजकमल प्रकाशन लोगो" : "Rajkamal Prakashan logo", type: "SVG", size: "21 KB", bg: "#fff" },
  { href: "/og/kitab-utsav.jpg", label: hi ? "शेयर इमेज, 1200×630" : "Share image, 1200×630", type: "JPG", size: "81 KB", bg: "#0b2e63" },
];
// Masthead numbers: volume = years running, issue = editions so far.
const vol = festivalTotals.find((x) => x.label.en === "years")?.value ?? "";
const issue = festivalTotals.find((x) => x.label.en === "editions")?.value ?? "";
const numbers = [
  ...festivalTotals.map((x) => ({ value: x.value, label: x.label[lang] })),
  { value: String(partners.length), label: hi ? "साथी" : "partners" },
  { value: `${allSpeakers.length}+`, label: hi ? "वक्ता" : "speakers" },
];
---
<Base lang={lang} route="/press/" title={title} description={description} crumbs={crumbs}>
  <section class="page-hero nw-hero">
    <div class="wrap">
      <Crumbs lang={lang} items={crumbs} />
      <header class="nw-mast">
        <p class="nw-mast__top">
          <span>{hi ? `खंड ${vol} · अंक ${issue}` : `Vol. ${vol} · No. ${issue}`}</span>
          <span data-today></span>
          <span>{hi ? "मीडिया और प्रेस" : "Press & media"}</span>
        </p>
        <h1 class="nw-mast__name">{hi ? "किताब उत्सव समाचार" : <>The Kitab Utsav <em>Times</em></>}</h1>
        <p class="nw-mast__sub">{hi ? "पत्रकारों और आयोजकों के लिए: कवरेज, तथ्य, लोगो और संपर्क, एक जगह।" : "For journalists and partners: coverage, facts, logos and contacts, in one place."}</p>
      </header>
      <ul class="nw-ticker" aria-label={hi ? "अब तक" : "So far"}>
        {numbers.map((n) => <li><b>{n.value}</b> {n.label}</li>)}
      </ul>
    </div>
  </section>

  <section class="section nw-body">
    <div class="wrap nw-grid">
      <div class="nw-main">
        <h2 class="nw-head"><span>{hi ? "कवरेज" : "Coverage"}</span></h2>
        {coverage.length === 0 ? (
          <p class="nw-empty">{hi ? "प्रेस कवरेज के लिंक जल्द जोड़े जाएँगे।" : "Links to press coverage will be added soon."}</p>
        ) : (
          <ul class="nw-clips">
            {coverage.map((c, i) => {
              const e = c.edition ? editionBySlug(c.edition) : null;
              const cover = c.edition ? coverFor(c.edition) : undefined;
              const Tag = c.url ? "a" : "div";
              return (
                <li class:list={["nw-clip", { "is-slot": !c.url }]} style={`--tilt:${[-1.6, 1.2, -0.8, 1.8][i % 4]}deg`}>
                  <Tag class="nw-clip__in" {...(c.url ? { href: c.url, target: "_blank", rel: "noopener" } : {})}>
                    <span class="nw-clip__pin" aria-hidden="true"></span>
                    <span class="nw-clip__src">{c.url ? c.outlet[lang] : (hi ? "समाचार" : "News")}{c.date && ` · ${formatDate(c.date, lang)}`}</span>
                    <h3 class="nw-clip__h">{c.headline[lang]}</h3>
                    {cover && <span class="nw-clip__img" aria-hidden="true"><img src={cover.src} alt="" loading="lazy" decoding="async" /></span>}
                    <span class="nw-clip__meta">
                      {e && <span>{e.city[lang]} {e.year}</span>}
                      {c.url ? <span class="nw-clip__go">{hi ? "पूरी ख़बर" : "Read the story"} <Icon name="ext" /></span> : <span class="nw-stamp">{hi ? "क्लिपिंग जल्द" : "Clipping coming"}</span>}
                    </span>
                  </Tag>
                  {e && <a class="nw-clip__ed" href={localePath(lang, `/editions/${e.slug}/`)}>{hi ? `${e.city.hi} ${e.year} के बारे में` : `About ${e.city.en} ${e.year}`} →</a>}
                </li>
              );
            })}
          </ul>
        )}

        <h2 class="nw-head"><span>{hi ? "प्रेस किट" : "Press kit"}</span></h2>
        <ul class="nw-kit">
          {assets.map((a) => (
            <li>
              <a class="nw-kit__item" href={a.href} download>
                <span class="nw-kit__prev" style={`background:${a.bg}`}><img src={a.href} alt="" loading="lazy" decoding="async" /></span>
                <span class="nw-kit__name">{a.label}</span>
                <span class="nw-kit__meta"><i>{a.type}</i>{a.size}<Icon name="download" /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <aside class="nw-side">
        <section class="nw-glance" aria-labelledby="glance-h">
          <h2 id="glance-h">{hi ? "एक नज़र में" : "At a glance"}</h2>
          <dl>
            {facts.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}
            <dt>{hi ? "संस्करण" : "Editions"}</dt>
            <dd class="nw-glance__eds">{dated.map((e) => <a href={localePath(lang, `/editions/${e.slug}/`)}>{e.city[lang]} {e.year}</a>)}</dd>
          </dl>
          <p class="nw-glance__note">{hi ? `सबसे पुराना दर्ज संस्करण: ${first.city.hi}, ${formatRange(first, "hi")}।` : `Earliest edition on record here: ${first.city.en}, ${formatRange(first, "en")}.`}</p>
        </section>
        <section class="nw-desk" aria-labelledby="desk-h">
          <h2 id="desk-h"><Icon name="news" />{hi ? "प्रेस डेस्क" : "Press desk"}</h2>
          <p>{hi ? "इंटरव्यू, तस्वीरें या मान्यता के लिए लिखें या फ़ोन करें।" : "For interviews, photos or accreditation, write or call."}</p>
          <a class="nw-desk__mail" href={`mailto:${pressContact.email}?subject=${encodeURIComponent("Kitab Utsav: press")}`}><Icon name="mail" />{pressContact.email}</a>
          <div class="nw-desk__phones">{org.phones.map((p) => <a href={`tel:${p.tel}`}><Icon name="phone" />{p.label}</a>)}</div>
        </section>
      </aside>
    </div>
  </section>
</Base>
