---
import { bookSeatUrl } from "../site.config";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import NextEdition from "../components/NextEdition.astro";
import NextSoon from "../components/NextSoon.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import EditionCard from "../components/EditionCard.astro";
import CityThumb from "../components/CityThumb.astro";
import Clouds from "../components/Clouds.astro";
import SpeakerCard from "../components/SpeakerCard.astro";
import SpeakerWall from "../components/SpeakerWall.astro";
import { speakersFor, allSpeakers, festivalTotals, hashtag } from "../data/speakers";
import { editions, featuredEdition as fe, nextEdition, editionBySlug } from "../data/editions";
import { galleryFor } from "../data/gallery";
import { faq } from "../data/faq";
import { formatRange, localePath, t, type Lang } from "../i18n";
import { eventLd, faqLd } from "../lib/schema";
import { festivalSocial } from "../site.config";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const hi = lang === "hi";
const site = Astro.site!;
const og = "/og/kitab-utsav.jpg";
/** true while an edition is announced and not over; false in the gap between editions. */
const up = !!nextEdition;

const title = hi
  ? `किताब उत्सव ${fe.year} | राजकमल प्रकाशन समूह का पुस्तक उत्सव`
  : `Kitab Utsav ${fe.year} | Rajkamal Prakashan's Hindi Book Festival`;
const description = hi
  ? `किताब उत्सव: किताबों, पाठकों और लेखकों के संवाद का उत्सव। ${up ? `राजकमल प्रकाशन समूह के इस उत्सव का अगला पड़ाव ${fe.city.hi}, ${formatRange(fe, "hi")}।` : `हाल का पड़ाव ${fe.city.hi}, ${formatRange(fe, "hi")}; अगले शहर की घोषणा जल्द।`} पाठ, बातचीत, चर्चा, लोकार्पण और पुस्तक प्रदर्शनी।`
  : `Kitab Utsav is Rajkamal Prakashan's five-day Hindi book and literature festival. ${up ? `Next stop: ${fe.city.en}, ${formatRange(fe, "en")}.` : `Most recently in ${fe.city.en}, ${formatRange(fe, "en")}; next city announcing soon.`} Readings, conversations, book launches and a book exhibition.`;

const formats = hi
  ? [
      { icon: "chat", h: "लेखक से मुलाक़ात", p: "लेखकों से आमने-सामने, उनकी किताबों और ज़िन्दगी पर बातचीत और हस्ताक्षर।" },
      { icon: "book", h: "पाठ", p: "कहानी, कविता और गद्य का पाठ, लेखकों की अपनी आवाज़ में।" },
      { icon: "mic2", h: "चर्चा", p: "किताबों और समाज के सवालों पर खुली बहस।" },
      { icon: "spark", h: "लोकार्पण", p: "नई किताबें, पहली बार पाठकों के बीच।" },
      { icon: "shelf", h: "पुस्तक प्रदर्शनी", p: "राजकमल, राधाकृष्ण, लोकभारती और राजकमल उर्दू की किताबें।" },
      { icon: "stage", h: "प्रस्तुतियाँ", p: "दास्तानगोई, लोक-प्रस्तुतियाँ और काव्य संध्या।" },
      { icon: "spark", h: "कार्यशालाएँ", p: "लेखन, अनुवाद और कहानी सुनाने की कार्यशालाएँ।" },
      { icon: "book", h: "बाल-साहित्य", p: "बच्चों के लिए कहानी-सत्र और किताबों की गतिविधियाँ।" },
      { icon: "chat", h: "हस्ताक्षर सत्र", p: "अपनी पसंदीदा किताब पर लेखक के हस्ताक्षर।" },
    ]
  : [
      { icon: "chat", h: "Author meets", p: "Face to face with writers about their books and lives, with signings." },
      { icon: "book", h: "Readings", p: "Stories, poems and prose read in the writers' own voices." },
      { icon: "mic2", h: "Discussions", p: "Open debate on books and the questions around us." },
      { icon: "spark", h: "Book launches", p: "New titles meeting readers for the first time." },
      { icon: "shelf", h: "Book exhibition", p: "Books from Rajkamal, Radhakrishna, Lokbharti and Rajkamal Urdu." },
      { icon: "stage", h: "Performances", p: "Dastangoi, folk performances and poetry evenings." },
      { icon: "spark", h: "Workshops", p: "Writing, translation and storytelling workshops." },
      { icon: "book", h: "Children's sessions", p: "Story hours and book activities for young readers." },
      { icon: "chat", h: "Book signings", p: "Get your favourite book signed by its author." },
    ];

const journey = [
  { city: hi ? "भोपाल" : "Bhopal", note: hi ? "शुरुआत" : "Where it began" },
  { city: hi ? "बनारस" : "Banaras", note: "" },
  { city: hi ? "पटना" : "Patna", note: "2022", slug: "patna-2022" },
  { city: hi ? "चंडीगढ़" : "Chandigarh", note: "2023", slug: "chandigarh-2023" },
  { city: hi ? "लखनऊ" : "Lucknow", note: "2024", slug: "lucknow-2024" },
  { city: hi ? "भोपाल" : "Bhopal", note: "2025", slug: "bhopal-2025" },
  { city: hi ? "मुम्बई" : "Mumbai", note: "2026", slug: "mumbai-2026" },
  { city: hi ? "पटना" : "Patna", note: "2026", slug: "patna-2026" },
  { city: hi ? "इन्दौर" : "Indore", note: "2026", slug: "indore-2026" },
  { city: hi ? "बरेली" : "Bareilly", note: hi ? "अक्टूबर 2026" : "Oct 2026", slug: "bareilly-2026" },
];
if (!nextEdition) journey.push({ city: hi ? "अगला शहर?" : "Next city?", note: hi ? "घोषणा जल्द" : "Announcing soon" });
const bhopal = editionBySlug("bhopal-2025")!;
const faqTop = faq[lang].slice(0, 4);
const announced = speakersFor(fe.slug);
const ribbonItems = hi
  ? ["लेखक से मुलाक़ात", "काव्य-पाठ", "पुस्तक प्रदर्शनी", "लोकार्पण", "परिचर्चाएँ", "कार्यशालाएँ", "बाल-साहित्य", "दास्तानगोई"]
  : ["Author meets", "Poetry readings", "Book exhibition", "Book launches", "Conversations", "Workshops", "Children's literature", "Dastangoi"];
const ev = up ? eventLd(fe, lang, site, og) : null;
const recentPhotos = galleryFor(fe.slug).slice(0, 5);
const jsonLd = [ev, faqLd(faqTop)].filter(Boolean) as Record<string, unknown>[];
const seatHref = bookSeatUrl ?? localePath(lang, `/editions/${fe.slug}/`);
const days = Array.from({ length: 5 }, (_, i) => {
  const d = new Date(`${fe.start}T00:00:00+05:30`);
  d.setDate(d.getDate() + i);
  return {
    n: i + 1,
    day: d.toLocaleDateString(hi ? "hi-IN" : "en-IN", { day: "numeric", timeZone: "Asia/Kolkata" }),
    rest: d.toLocaleDateString(hi ? "hi-IN" : "en-IN", { month: "short", weekday: "short", timeZone: "Asia/Kolkata" }),
  };
});
---
<Base lang={lang} route="/" title={title} description={description} image={og} jsonLd={jsonLd}>
  <section class="hero">
    <Clouds />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{hi ? "राजकमल प्रकाशन समूह प्रस्तुत करता है" : "Rajkamal Prakashan Samuh presents"}</p>
        <h1 class="hero-title">
          <span>{hi ? "किताबों का" : "A festival"}</span>
          <strong>{hi ? "सबसे जीवंत उत्सव" : "alive with books"}</strong>
        </h1>
        {up ? (
          <p class="hero-edition-line">
            <span>{fe.city[lang]}</span>
            <i aria-hidden="true"></i>
            <b>{formatRange(fe, lang)}</b>
          </p>
        ) : (
          <p class="hero-edition-line">
            <span>{hi ? "अगला शहर" : "Next city"}</span>
            <i aria-hidden="true"></i>
            <b>{hi ? "घोषणा जल्द" : "announcing soon"}</b>
          </p>
        )}
        <p class="lead">
          {hi
            ? "लेखक से मुलाक़ात, लोकार्पण, काव्य-पाठ, परिचर्चाएँ, कार्यशालाएँ और पुस्तक प्रदर्शनी: साहित्य की हर गतिविधि, एक शहर में पाँच दिन।"
            : "Author meets, book launches, poetry readings, panel talks, workshops and a book exhibition: every kind of literary activity, five days in one city."}
        </p>
        <ul class="totals" aria-label={hi ? "अब तक" : "So far"}>
          {festivalTotals.map((x) => <li><b>{x.value}</b>{x.label[lang]}</li>)}
        </ul>
        <div class="btns">
          {up
            ? <a class="btn btn--primary" href={seatHref} {...(bookSeatUrl ? { target: "_blank", rel: "noopener" } : {})}>{s.bookSeat}</a>
            : <a class="btn btn--primary" href="#newsletter">{hi ? "अगले उत्सव की ख़बर पाएँ" : "Hear about the next one"}</a>}
          <a class="btn" href={localePath(lang, "/editions/")}>{s.allEditions}</a>
        </div>
      </div>
      <div class="hero-side">
        <img class="hero-art" src="/brand/hero-element.svg" alt="" width="872" height="538" fetchpriority="high" />
        <span class="city-word" aria-hidden="true">{fe.city[lang]}</span>
        {up ? <NextEdition e={fe} lang={lang} /> : <NextSoon last={fe} lang={lang} />}
      </div>
    </div>
  </section>

  <div class="festival-ribbon" aria-label={hi ? "किताब उत्सव की मुख्य गतिविधियाँ" : "Kitab Utsav highlights"}>
    <div class="festival-ribbon__track">
      {ribbonItems.map((item) => <span>{item}</span>)}
    </div>
  </div>

  {up ? (
  <section class="section" aria-labelledby="days">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{hi ? `${fe.city.hi} में पाँच दिन` : `Five days in ${fe.city.en}`}</p>
          <h2 class="h2" id="days">{hi ? "दिन-दर-दिन आयोजन" : "Day-by-day events"}</h2>
        </div>
        <a class="link-more" href={localePath(lang, "/programme/")}>{s.nav.programme}</a>
      </div>
      <ol class="days-strip">
        {days.map((d) => (
          <li>
            <a href={localePath(lang, "/programme/")}>
              <small>{hi ? `दिन ${d.n}` : `Day ${d.n}`}</small>
              <b>{d.day}</b>
              <span>{d.rest}</span>
              <em>{hi ? "सत्र-सूची शीघ्र" : "Sessions soon"}</em>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
  ) : (
  <section class="section" aria-labelledby="recap">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{hi ? "हाल ही में" : "Just wrapped"}</p>
          <h2 class="h2" id="recap">{hi ? `${fe.city.hi} में पाँच दिन` : `Five days in ${fe.city.en}`}</h2>
          <p class="lead">{fe.summary[lang]}</p>
        </div>
        <a class="link-more" href={localePath(lang, `/editions/${fe.slug}/`)}>{s.exploreDetails}</a>
      </div>
      <GalleryGrid items={recentPhotos} lang={lang} />
      <p class="gallery-more"><a class="btn" href={localePath(lang, "/gallery/")}><Icon name="camera" />{hi ? "पूरी गैलरी" : "Full gallery"}</a></p>
    </div>
  </section>
  )}

  {announced.length > 0 && (
    <section class="section" aria-labelledby="speakers">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">{up ? (hi ? `किताब उत्सव ${fe.city.hi} में मिलिए` : `Meet them in ${fe.city.en}`) : (hi ? `किताब उत्सव ${fe.city.hi}` : `Kitab Utsav ${fe.city.en}`)}</p>
            <h2 class="h2" id="speakers">{up ? (hi ? "अब तक घोषित वक्ता" : "Speakers announced so far") : (hi ? `${fe.city.hi} के मंच पर` : `On stage in ${fe.city.en}`)}</h2>
          </div>
          <a class="link-more" href={localePath(lang, "/resources/")}>{hi ? "सभी लेखक" : "All authors"}</a>
        </div>
        <div class="grid grid--3">{announced.map((sp) => <SpeakerCard s={sp} lang={lang} />)}</div>
      </div>
    </section>
  )}

  {allSpeakers.length > 0 && (
    <section class="section" aria-labelledby="wall">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">{hi ? "किताब उत्सव में अब तक" : "At Kitab Utsav so far"}</p>
            <h2 class="h2" id="wall">{hi ? "लेखक, कवि और रंगकर्मी जो यहाँ आए" : "Writers, poets and artists who've been here"}</h2>
            <p class="lead">
              {hi
                ? "अलग-अलग शहरों और संस्करणों में किताब उत्सव का हिस्सा रहे चुनिंदा रचनाकार। किसी नाम पर कर्सर रखें या टैप करें—उनकी भूमिका, शहर और वर्ष सामने आएँगे।"
                : "Selected writers who have joined Kitab Utsav across cities and editions. Hover or tap a name to see their role, city and year."}
            </p>
          </div>
        </div>
        <SpeakerWall speakers={allSpeakers} lang={lang} />
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="what">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{hi ? "उत्सव में क्या होता है" : "What happens at the festival"}</p>
          <h2 class="h2" id="what">{hi ? "किताबों के बहाने, बातों का उत्सव" : "A festival of conversation, built around books"}</h2>
          <p class="lead">
            {hi
              ? "किताब उत्सव में पाठक सिर्फ़ किताबें नहीं ख़रीदते, उन्हें लिखने वालों से मिलते हैं। हर दिन सुबह से रात तक सत्र चलते हैं और साथ में प्रदर्शनी खुली रहती है।"
              : "At Kitab Utsav readers do more than buy books: they meet the people who write them. Sessions run from morning to night, with the exhibition open alongside."}
          </p>
        </div>
      </div>
      <div class="grid grid--3">
        {formats.map((f) => (
          <div class="card format">
            <span class="ic"><Icon name={f.icon} /></span>
            <div><h3>{f.h}</h3><p>{f.p}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="journey">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{hi ? "शहर दर शहर" : "City by city"}</p>
          <h2 class="h2" id="journey">{hi ? `भोपाल से ${fe.city.hi} तक का सफ़र` : `The journey from Bhopal to ${fe.city.en}`}</h2>
          <p class="lead">
            {hi
              ? "किताब उत्सव की शुरुआत भोपाल में राजकमल प्रकाशन के स्थापना के 75वें वर्ष में हुई। तब से यह उत्सव हिन्दी के बड़े-छोटे शहरों में पाठकों तक पहुँच रहा है।"
              : "Kitab Utsav began in Bhopal in the 75th year of Rajkamal Prakashan. Since then it has travelled to Hindi-reading cities large and small."}
          </p>
        </div>
        <a class="link-more" href={localePath(lang, "/editions/")}>{s.allEditions}</a>
      </div>
      <ol class="journey journey--cards">
        {journey.map((j) => (
          <li class="journey-card">
            <div class="journey-thumb">
              <CityThumb city={j.city} label={j.city} />
            </div>
            <div class="journey-body">
              <b>{j.city}</b>
              {j.note && <span>{j.note}</span>}
              {j.slug ? (
                <a class="btn btn--sm journey-cta" href={localePath(lang, `/editions/${j.slug}/`)}>
                  {s.exploreDetails}
                </a>
              ) : (
                <span class="journey-soon">{s.detailsSoon}</span>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="numbers">
    <div class="wrap">
      <p class="eyebrow">{hi ? "भोपाल 2025, आँकड़ों में" : "Bhopal 2025, in numbers"}</p>
      <h2 class="h2" id="numbers">{hi ? "एक संस्करण, पाँच दिन" : "One edition, five days"}</h2>
      <ul class="stats">
        {bhopal.stats!.map((st) => <li><b>{st.value}</b><span>{st.label[lang]}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="recent">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{s.nav.editions}</p>
          <h2 class="h2" id="recent">{hi ? "हाल के संस्करण" : "Recent editions"}</h2>
        </div>
        <a class="link-more" href={localePath(lang, "/editions/")}>{s.allEditions}</a>
      </div>
      <div class="grid grid--3">
        {editions.slice(0, 6).map((e) => <EditionCard e={e} lang={lang} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{s.nav.faq}</p>
          <h2 class="h2" id="faq">{hi ? "अक्सर पूछे जाने वाले सवाल" : "Frequently asked questions"}</h2>
        </div>
        <a class="link-more" href={localePath(lang, "/faq/")}>{s.readMore}</a>
      </div>
      <div class="faq">
        {faqTop.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <div class="answer"><p set:html={f.a} /></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="cta-band">
      <Clouds items={[{ x: "55%", y: "-30%", w: 260 }, { x: "-6%", y: "50%", w: 200, flip: true }]} />
      <div>
        <h2>{s.followUs}</h2>
        <p>{hi ? "अगला शहर, वक्ताओं के नाम और उत्सव की झलकियाँ सबसे पहले आपके पास।" : "The next city, speaker lists and festival moments, first."} <span class="hashtag">{hashtag}</span></p>
      </div>
      <div class="btns">
        {festivalSocial.map((x, i) => (
          <a class:list={["btn", { "btn--primary": i === 0 }]} href={x.url} target="_blank" rel="noopener"><Icon name={x.name} />{x.handle}</a>
        ))}
      </div>
    </div>
  </div>
</Base>
