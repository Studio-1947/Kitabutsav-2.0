---
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Clouds from "../components/Clouds.astro";
import EditionCard from "../components/EditionCard.astro";
import { editions } from "../data/editions";
import { localePath, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const hi = lang === "hi";
const site = Astro.site!;
const title = hi ? "किताब उत्सव के सभी संस्करण: शहर, तारीख़ें और स्थान" : "All Kitab Utsav editions: cities, dates and venues";
const description = hi
  ? "राजकमल किताब उत्सव के सभी संस्करण: बरेली, इन्दौर, पटना, मुम्बई, भोपाल, लखनऊ, चंडीगढ़ और पटना। हर शहर की तारीख़ें, आयोजन स्थल और झलकियाँ।"
  : "Every Rajkamal Kitab Utsav edition: Bareilly, Indore, Patna, Mumbai, Bhopal, Lucknow, Chandigarh and Patna, with dates, venues and highlights.";
const crumbs = [{ name: s.nav.editions, path: "/editions/" }];
const byYear = [...new Set(editions.map((e) => e.year))].sort((a, b) => b - a);
const itemList = {
  "@type": "ItemList",
  name: title,
  itemListElement: editions.map((e, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(localePath(lang, `/editions/${e.slug}/`), site).href,
    name: hi ? `किताब उत्सव ${e.city.hi} ${e.year}` : `Kitab Utsav ${e.city.en} ${e.year}`,
  })),
};
---
<Base lang={lang} route="/editions/" title={title} description={description} crumbs={crumbs} jsonLd={[itemList]}>
  <section class="page-hero">
    <Clouds items={[{ x: "70%", y: "-10%", w: 260 }, { x: "88%", y: "45%", w: 180, flip: true }]} />
    <div class="wrap">
      <Crumbs lang={lang} items={crumbs} />
      <p class="eyebrow">{hi ? "शहर दर शहर" : "City by city"}</p>
      <h1>{hi ? "किताब उत्सव के संस्करण" : "Kitab Utsav editions"}</h1>
      <p class="lead">
        {hi
          ? "पाँच वर्षों में सात राज्यों के ग्यारह शहरों में सोलह आयोजन। भोपाल में शुरुआत के बाद किताब उत्सव बनारस, पटना, चंडीगढ़, लखनऊ, मुम्बई, इन्दौर और बरेली तक पहुँचा है। नीचे वे संस्करण हैं जिनकी पूरी जानकारी उपलब्ध है।"
          : "Sixteen editions in eleven cities across seven states, in five years. Since its start in Bhopal, Kitab Utsav has reached Banaras, Patna, Chandigarh, Lucknow, Mumbai, Indore and Bareilly. Below are the editions with full details on record."}
      </p>
    </div>
  </section>
  {byYear.map((y) => (
    <section class="section" style="padding-top:48px" aria-labelledby={`y${y}`}>
      <div class="wrap">
        <h2 class="h2" id={`y${y}`} style="margin-bottom:20px">{y}</h2>
        <div class="grid grid--3">
          {editions.filter((e) => e.year === y).map((e) => <EditionCard e={e} lang={lang} />)}
        </div>
      </div>
    </section>
  ))}
</Base>
