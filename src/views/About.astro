---
/**
 * About Kitab Utsav: the festival's story, every edition and the photo gallery on one page.
 * /editions/ and /gallery/ redirect here (see astro.config.mjs); edition detail pages stay.
 */
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Clouds from "../components/Clouds.astro";
import EditionCard from "../components/EditionCard.astro";
import GalleryGrid from "../components/GalleryGrid.astro";
import { editions } from "../data/editions";
import { galleryFor, hasRealPhotos } from "../data/gallery";
import { festivalTotals } from "../data/speakers";
import { festivalSocial, org } from "../site.config";
import { formatRange, localePath, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const hi = lang === "hi";
const site = Astro.site!;
const title = hi ? "किताब उत्सव के बारे में: कहानी, संस्करण और तस्वीरें" : "About Kitab Utsav: the story, every edition and the gallery";
const description = hi
  ? "किताब उत्सव राजकमल प्रकाशन समूह का घूमता हुआ हिन्दी पुस्तक उत्सव है। इसकी शुरुआत, अब तक के सभी संस्करण (शहर, तारीख़ें, स्थान) और हर पड़ाव की तस्वीरें।"
  : "Kitab Utsav is Rajkamal Prakashan Samuh's travelling Hindi book festival. How it began, every edition so far (cities, dates, venues) and photos from each stop.";
const label = hi ? "किताब उत्सव के बारे में" : "About Kitab Utsav";
const crumbs = [{ name: label, path: "/about/" }];
const byYear = [...new Set(editions.map((e) => e.year))].sort((a, b) => b - a);
const withPhotos = editions.filter((e) => galleryFor(e.slug).length);
const itemList = {
  "@type": "ItemList",
  name: hi ? "किताब उत्सव के संस्करण" : "Kitab Utsav editions",
  itemListElement: editions.map((e, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(localePath(lang, `/editions/${e.slug}/`), site).href,
    name: hi ? `किताब उत्सव ${e.city.hi} ${e.year}` : `Kitab Utsav ${e.city.en} ${e.year}`,
  })),
};
const sections = [
  { id: "story", label: hi ? "परिचय" : "The story" },
  { id: "editions", label: hi ? "संस्करण" : "Editions" },
  { id: "gallery", label: hi ? "गैलरी" : "Gallery" },
];
---
<Base lang={lang} route="/about/" title={title} description={description} crumbs={crumbs} jsonLd={[itemList]}>
  <section class="page-hero">
    <Clouds items={[{ x: "70%", y: "-10%", w: 260 }, { x: "88%", y: "45%", w: 180, flip: true }]} />
    <div class="wrap">
      <Crumbs lang={lang} items={crumbs} />
      <p class="eyebrow">{label}</p>
      <h1>{hi ? <>किताबें जहाँ <em>पाठकों से मिलती हैं</em></> : <>Where books <em>meet their readers</em></>}</h1>
      <ul class="totals" aria-label={hi ? "अब तक" : "So far"}>
        {festivalTotals.map((x) => <li><b>{x.value}</b>{x.label[lang]}</li>)}
      </ul>
    </div>
  </section>

  <nav class="page-tabs" aria-label={hi ? "इस पेज पर" : "On this page"}>
    <div class="wrap">
      {sections.map((x) => <a href={`#${x.id}`}>{x.label}</a>)}
    </div>
  </nav>

  <section class="section anchor" id="story" style="padding-top:40px" aria-label={sections[0].label}>
    <div class="wrap prose">
      {hi ? (
        <>
          <p>किताब उत्सव किताबों, पाठकों और लेखकों के संवाद का उत्सव है, जिसे राजकमल प्रकाशन समूह शहर-शहर ले जाता है। इसका नारा है: साथ जुड़ें, साथ पढ़ें। पाँच वर्षों में यह सात राज्यों के ग्यारह शहरों में सोलह बार आयोजित हो चुका है। इसका विचार सीधा है: किताबें और उन्हें लिखने वाले ख़ुद पाठकों के शहर तक पहुँचें। हर पड़ाव पर, आम तौर पर पाँच दिनों तक, सुबह से रात तक पाठ, बातचीत, चर्चा और लोकार्पण के सत्र चलते हैं और साथ में किताबों की प्रदर्शनी लगती है।</p>
          <h2>शुरुआत</h2>
          <p>किताब उत्सव की शुरुआत भोपाल में हुई, राजकमल प्रकाशन के स्थापना के 75वें वर्ष में। भोपाल और बनारस के बाद नवम्बर 2022 में पटना में नौ दिनों का उत्सव हुआ। फिर चंडीगढ़ (फ़रवरी 2023), लखनऊ (जनवरी 2024), भोपाल (सितम्बर 2025, शहर में तीसरा आयोजन), मुम्बई (फ़रवरी 2026), पटना (अप्रैल 2026) और इन्दौर (सितम्बर 2026) में उत्सव हुए। अक्टूबर 2026 में यह बरेली लौटा।</p>
          <h2>उत्सव में क्या होता है</h2>
          <ul>
            <li>लेखकों से बातचीत और पाठक-लेखक संवाद</li>
            <li>कहानी, कविता और गद्य का पाठ</li>
            <li>किताबों और समकालीन सवालों पर चर्चा</li>
            <li>नई किताबों के लोकार्पण</li>
            <li>दास्तानगोई, लोक-प्रस्तुतियाँ और काव्य संध्या</li>
            <li>राजकमल, राधाकृष्ण, लोकभारती और राजकमल उर्दू की किताबों की प्रदर्शनी</li>
          </ul>
          <h2>राजकमल प्रकाशन समूह</h2>
          <p>1947 में स्थापित राजकमल प्रकाशन हिन्दी के प्रमुख प्रकाशन घरानों में है। समूह में राजकमल प्रकाशन, राधाकृष्ण प्रकाशन, लोकभारती प्रकाशन और राजकमल उर्दू शामिल हैं। मुख्यालय नई दिल्ली के दरियागंज में है और पटना, प्रयागराज व मुम्बई में शाखाएँ हैं।</p>
          <p>समूह की किताबें ऑनलाइन <a href={org.url} target="_blank" rel="noopener">rajkamalprakashan.com</a> पर उपलब्ध हैं। अपने शहर में किताब उत्सव के लिए <a href={`mailto:${org.email}?subject=Kitab%20Utsav`}>{org.email}</a> पर लिखें, या नीचे <a href="#editions">अब तक के संस्करण</a> देखें।</p>
        </>
      ) : (
        <>
          <p>Kitab Utsav is a festival of conversation between books, readers and writers, taken from city to city by Rajkamal Prakashan Samuh under the line "saath judein, saath padhein" (come together, read together). In five years it has held sixteen editions in eleven cities across seven states. The idea is simple: bring books, and the people who write them, to readers in their own city. At each stop, usually for five days, sessions of readings, conversations, discussions and book launches run from morning to night alongside an exhibition of books.</p>
          <h2>How it began</h2>
          <p>Kitab Utsav began in Bhopal in the 75th year of Rajkamal Prakashan. After Bhopal and Banaras came a nine-day edition in Patna in November 2022, followed by Chandigarh (February 2023), Lucknow (January 2024), Bhopal again (September 2025, the city's third), Mumbai (February 2026), Patna (April 2026) and Indore (September 2026). In October 2026 it returned to Bareilly.</p>
          <h2>What happens at the festival</h2>
          <ul>
            <li>Conversations with writers and open reader Q&amp;A</li>
            <li>Readings of fiction, poetry and prose</li>
            <li>Discussions on books and the questions of our time</li>
            <li>Launches of new books</li>
            <li>Dastangoi, folk performances and poetry evenings</li>
            <li>An exhibition of books from Rajkamal, Radhakrishna, Lokbharti and Rajkamal Urdu</li>
          </ul>
          <h2>Rajkamal Prakashan Samuh</h2>
          <p>Founded in 1947, Rajkamal Prakashan is one of the leading Hindi publishing houses. The group includes Rajkamal Prakashan, Radhakrishna Prakashan, Lokbharti Prakashan and Rajkamal Urdu, with its head office in Daryaganj, New Delhi, and branches in Patna, Prayagraj and Mumbai.</p>
          <p>The group's books are available online at <a href={org.url} target="_blank" rel="noopener">rajkamalprakashan.com</a>. To bring Kitab Utsav to your city, write to <a href={`mailto:${org.email}?subject=Kitab%20Utsav`}>{org.email}</a>, or browse the <a href="#editions">editions so far</a> below.</p>
        </>
      )}
    </div>
  </section>

  <section class="section anchor" id="editions" aria-labelledby="editions-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{hi ? "शहर दर शहर" : "City by city"}</p>
          <h2 class="h2" id="editions-h">{hi ? "अब तक के संस्करण" : "Editions so far"}</h2>
          <p class="lead">
            {hi
              ? "नीचे वे संस्करण हैं जिनकी पूरी जानकारी उपलब्ध है। किसी शहर पर क्लिक करें: तारीख़ें, स्थान, वक्ता और तस्वीरें।"
              : "Below are the editions with full details on record. Open a city for its dates, venue, speakers and photos."}
          </p>
        </div>
      </div>
      {byYear.map((y) => (
        <div class="year-block">
          <h3 class="year-block__y">{y}</h3>
          <div class="grid grid--3">
            {editions.filter((e) => e.year === y).map((e) => <EditionCard e={e} lang={lang} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section anchor" id="gallery" aria-labelledby="gallery-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{hi ? "गैलरी" : "Gallery"}</p>
          <h2 class="h2" id="gallery-h">{hi ? "शहर दर शहर, तस्वीरों में" : "City by city, in pictures"}</h2>
        </div>
      </div>
      {!hasRealPhotos && (
        <div class="notice" role="note">
          <p>
            {hi ? "तस्वीरें जोड़ी जा रही हैं। तब तक उत्सव की झलकियाँ " : "Photos are being added. Until then, see festival moments on "}
            <a href={festivalSocial[0].url} target="_blank" rel="noopener" style="text-decoration:underline">{festivalSocial[0].handle}</a>
            {hi ? " पर देखें।" : "."}
          </p>
        </div>
      )}
      <div data-gallery-tabs>
        <div class="chips" role="tablist" aria-label={hi ? "संस्करण चुनें" : "Choose an edition"}>
          {withPhotos.map((e, i) => (
            <button type="button" class="chip" role="tab" id={`gt-${e.slug}`} aria-controls={`gp-${e.slug}`} aria-selected={i === 0 ? "true" : "false"} aria-pressed={i === 0 ? "true" : "false"}>
              {e.city[lang]} {e.year}
            </button>
          ))}
        </div>
        {withPhotos.map((e, i) => (
          <div class="gallery-panel" role="tabpanel" id={`gp-${e.slug}`} aria-labelledby={`gt-${e.slug}`} hidden={i !== 0}>
            <p class="gallery-panel__meta">
              {formatRange(e, lang)}{e.venue && ` · ${e.venue[lang]}`}
              <a class="link-more" href={localePath(lang, `/editions/${e.slug}/`)}>{s.exploreDetails}</a>
            </p>
            <GalleryGrid items={galleryFor(e.slug)} lang={lang} />
          </div>
        ))}
      </div>
    </div>
  </section>
  <script is:inline>
    document.querySelectorAll("[data-gallery-tabs]").forEach(function (w) {
      var tabs = w.querySelectorAll("[role=tab]");
      var show = function (id) {
        tabs.forEach(function (t) {
          var on = t.getAttribute("aria-controls") === id;
          t.setAttribute("aria-selected", String(on)); t.setAttribute("aria-pressed", String(on));
          document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
        });
      };
      tabs.forEach(function (t) { t.addEventListener("click", function () { show(t.getAttribute("aria-controls")); }); });
      // /about/#gallery-indore-2026 (and old /gallery/#indore-2026 links) open that edition.
      var m = location.hash.match(/^#(?:gallery-)?([a-z]+-\d{4})$/);
      if (m && document.getElementById("gp-" + m[1])) { show("gp-" + m[1]); document.getElementById("gallery").scrollIntoView(); }
    });
  </script>
</Base>
