---
/**
 * About Kitab Utsav: the festival's story, every edition and the photo gallery on one page.
 * /editions/ and /gallery/ redirect here (see astro.config.mjs); edition detail pages stay.
 */
import Base from "../layouts/Base.astro";
import Crumbs from "../components/Crumbs.astro";
import Clouds from "../components/Clouds.astro";
import Landmark from "../components/Landmark.astro";
import Icon from "../components/Icon.astro";
import { editions, nextEdition, startKey } from "../data/editions";
import { galleryFor, coverFor, focusOf } from "../data/gallery";
import { festivalTotals } from "../data/speakers";
import { org } from "../site.config";
import { formatRange, localePath, t, type Lang } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const hi = lang === "hi";
const site = Astro.site!;
const title = hi ? "किताब उत्सव के बारे में: कहानी, संस्करण और तस्वीरें" : "About Kitab Utsav: the story, every edition and the gallery";
const description = hi
  ? "किताब उत्सव राजकमल प्रकाशन समूह का घूमता हुआ हिन्दी पुस्तक उत्सव है। इसकी शुरुआत, अब तक के सभी संस्करण (शहर, तारीख़ें, स्थान) और हर पड़ाव की तस्वीरें।"
  : "Kitab Utsav is Rajkamal Prakashan Samuh's travelling Hindi book festival. How it began, every edition so far (cities, dates, venues) and photos from each stop.";
const label = hi ? "किताब उत्सव के बारे में" : "About Kitab Utsav";
const crumbs = [{ name: label, path: "/about/" }];
const withPhotos = editions.filter((e) => galleryFor(e.slug).length);
const totalPhotos = withPhotos.reduce((n, e) => n + galleryFor(e.slug).length, 0);
const itemList = {
  "@type": "ItemList",
  name: hi ? "किताब उत्सव के संस्करण" : "Kitab Utsav editions",
  itemListElement: editions.map((e, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(localePath(lang, `/editions/${e.slug}/`), site).href,
    name: hi ? `किताब उत्सव ${e.city.hi} ${e.year}` : `Kitab Utsav ${e.city.en} ${e.year}`,
  })),
};
const sections = [
  { id: "story", label: hi ? "परिचय" : "The story" },
  { id: "editions", label: hi ? "संस्करण" : "Editions" },
  { id: "gallery", label: hi ? "गैलरी" : "Gallery" },
];

// The route: every edition, oldest first, laid out as a snake (3 across on desktop, 2 on tablets,
// 1 on phones). Each stop gets its grid position for each layout so rows can run back and forth.
const route = [...editions].sort((a, b) => startKey(a).localeCompare(startKey(b)));
const place = (i: number, cols: number) => {
  const row = Math.floor(i / cols), k = i % cols;
  return { r: row + 1, c: (row % 2 ? cols - 1 - k : k) + 1 };
};
const stopStyle = (i: number) => {
  const a = place(i, 3), b = place(i, 2);
  return `--r3:${a.r};--c3:${a.c};--r2:${b.r};--c2:${b.c}`;
};

// Hero collage and chapter photos (festival photos from the gallery).
const collage = [
  { src: "/gallery/bareilly-2026/bareilly-2026-004.webp", tilt: -5 },
  { src: "/gallery/mumbai-2026/mumbai-2026-191.webp", tilt: 4 },
  { src: "/gallery/patna-2026/patna-2026-150.webp", tilt: -2 },
];
const happens = hi
  ? ["लेखकों से बातचीत", "पाठक-लेखक संवाद", "कहानी, कविता, गद्य का पाठ", "समकालीन सवालों पर चर्चा", "नई किताबों के लोकार्पण", "दास्तानगोई और लोक-प्रस्तुतियाँ", "काव्य संध्या", "किताबों की प्रदर्शनी"]
  : ["Conversations with writers", "Open reader Q&A", "Readings of fiction, poetry and prose", "Discussions on the questions of our time", "Book launches", "Dastangoi and folk performances", "Poetry evenings", "A book exhibition"];
---

<Base lang={lang} route="/about/" title={title} description={description} crumbs={crumbs} jsonLd={[itemList]}>
  <section class="page-hero ab-hero">
    <Clouds items={[{ x: "46%", y: "-12%", w: 220 }, { x: "-6%", y: "70%", w: 180, flip: true }]} />
    <div class="wrap ab-hero__in">
      <div class="ab-hero__text">
        <Crumbs lang={lang} items={crumbs} />
        <p class="eyebrow">{label}</p>
        <h1>{hi ? <>किताबें जहाँ <em>पाठकों से मिलती हैं</em></> : <>Where books <em>meet their readers</em></>}</h1>
        <p class="lead">{hi ? "राजकमल प्रकाशन समूह का घूमता पुस्तक उत्सव, शहर दर शहर, बातचीत दर बातचीत।" : "Rajkamal Prakashan Samuh's travelling book festival, city by city, conversation by conversation."}</p>
        <ul class="totals ab-stats" aria-label={hi ? "अब तक" : "So far"}>
          {festivalTotals.map((x, i) => <li style={`--tilt:${[-3, 2, -1.5, 3][i % 4]}deg`}><b>{x.value}</b>{x.label[lang]}</li>)}
        </ul>
      </div>
      <div class="ab-collage" aria-hidden="true">
        {collage.map((c, i) => <span class={`ab-collage__p ab-collage__p--${i}`} style={`--tilt:${c.tilt}deg`}><img src={c.src} alt="" decoding="async" loading={i === 0 ? "eager" : "lazy"} /></span>)}
      </div>
    </div>
  </section>

  <nav class="page-tabs page-tabs--float" aria-label={hi ? "इस पेज पर" : "On this page"} data-spy>
    <div class="page-tabs__bar">
      <span class="page-tabs__ind" aria-hidden="true"></span>
      {sections.map((x) => <a href={`#${x.id}`}>{x.label}</a>)}
    </div>
  </nav>

  <section class="section anchor ab-story" id="story" aria-label={sections[0].label}>
    <div class="wrap">
      <div class="ab-lede">
        <p class="ab-intro">
          {hi
            ? <>किताब उत्सव किताबों, पाठकों और लेखकों के संवाद का उत्सव है, जिसे राजकमल प्रकाशन समूह शहर-शहर ले जाता है। पाँच वर्षों में <mark>सात राज्यों के ग्यारह शहरों में सोलह बार</mark>। विचार सीधा है: किताबें और उन्हें लिखने वाले, ख़ुद पाठकों के शहर तक पहुँचें।</>
            : <>Kitab Utsav is a festival of conversation between books, readers and writers, taken from city to city by Rajkamal Prakashan Samuh. In five years, <mark>sixteen editions in eleven cities across seven states</mark>. The idea is simple: bring books, and the people who write them, to readers in their own city.</>}
        </p>
        {/* the highlighted sentence above, as figures; the sentence stays for screen readers */}
        <ul class="ab-figures" aria-hidden="true">
          <li><b data-count>5</b><span>{hi ? "वर्ष" : "years"}</span></li>
          <li><b data-count>16</b><span>{hi ? "संस्करण" : "editions"}</span></li>
          <li><b data-count>11</b><span>{hi ? "शहर" : "cities"}</span></li>
          <li><b data-count>7</b><span>{hi ? "राज्य" : "states"}</span></li>
        </ul>
      </div>
      <div class="ab-chapters">
        <article class="ab-ch">
          <figure class="ab-ch__img"><img src="/gallery/bhopal-2025/bhopal-2025-301.webp" alt={hi ? "भोपाल किताब उत्सव में एक लेखक" : "A writer speaking at Kitab Utsav in Bhopal"} loading="lazy" decoding="async" /></figure>
          <div class="ab-ch__text">
            <span class="ab-ch__no" aria-hidden="true">01</span>
            <h2>{hi ? "शुरुआत" : "How it began"}</h2>
            <p>{hi
              ? "किताब उत्सव की शुरुआत भोपाल में हुई, राजकमल प्रकाशन के स्थापना के 75वें वर्ष में। भोपाल और बनारस के बाद नवम्बर 2022 में पटना में नौ दिनों का उत्सव हुआ। फिर चंडीगढ़, लखनऊ, भोपाल, मुम्बई, पटना और इन्दौर, और अक्टूबर 2026 में बरेली।"
              : "Kitab Utsav began in Bhopal in the 75th year of Rajkamal Prakashan. After Bhopal and Banaras came a nine-day edition in Patna in November 2022, then Chandigarh, Lucknow, Bhopal again, Mumbai, Patna and Indore, and in October 2026, Bareilly."}</p>
          </div>
        </article>
        <article class="ab-ch">
          <figure class="ab-ch__img"><img src="/gallery/bareilly-2026/bareilly-2026-028.webp" alt={hi ? "किताब उत्सव में पाठ-प्रस्तुति" : "A reading at Kitab Utsav"} loading="lazy" decoding="async" /></figure>
          <div class="ab-ch__text">
            <span class="ab-ch__no" aria-hidden="true">02</span>
            <h2>{hi ? "उत्सव में क्या होता है" : "What happens"}</h2>
            <p>{hi ? "हर पड़ाव पर, आम तौर पर पाँच दिन, सुबह से रात तक:" : "At each stop, usually for five days, from morning to night:"}</p>
            <ul class="ab-ch__tags">{happens.map((h) => <li>{h}</li>)}</ul>
          </div>
        </article>
        <article class="ab-ch">
          <figure class="ab-ch__img"><img src="/gallery/bareilly-2026/bareilly-2026-015.webp" alt={hi ? "किताब उत्सव की पुस्तक प्रदर्शनी" : "The book exhibition at Kitab Utsav"} loading="lazy" decoding="async" /></figure>
          <div class="ab-ch__text">
            <span class="ab-ch__no" aria-hidden="true">03</span>
            <h2>{hi ? "राजकमल प्रकाशन समूह" : "Rajkamal Prakashan Samuh"}</h2>
            <p>{hi
              ? "1947 में स्थापित, हिन्दी के प्रमुख प्रकाशन घरानों में। समूह में राजकमल प्रकाशन, राधाकृष्ण प्रकाशन, लोकभारती प्रकाशन और राजकमल उर्दू शामिल हैं; मुख्यालय दरियागंज, नई दिल्ली में, शाखाएँ पटना, प्रयागराज और मुम्बई में।"
              : "Founded in 1947, one of the leading Hindi publishing houses. The group brings together Rajkamal Prakashan, Radhakrishna Prakashan, Lokbharti Prakashan and Rajkamal Urdu, with its head office in Daryaganj, New Delhi, and branches in Patna, Prayagraj and Mumbai."}</p>
            <div class="ab-ch__links">
              <a class="btn btn--ink btn--sm" href={org.url} target="_blank" rel="noopener">{s.nav.shop} <Icon name="arrowUpRight" size={16} /></a>
              <a class="btn btn--line btn--sm" href={`mailto:${org.email}?subject=${encodeURIComponent(hi ? "हमारे शहर में किताब उत्सव" : "Kitab Utsav in our city")}`}>{hi ? "अपने शहर बुलाएँ" : "Bring it to your city"}</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section anchor ab-route" id="editions" aria-labelledby="editions-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{hi ? "शहर दर शहर" : "City by city"}</p>
          <h2 class="h2" id="editions-h">{hi ? "अब तक का सफ़र" : "The journey so far"}</h2>
          <p class="lead">{hi ? "पटना 2022 से आगे, हर पड़ाव। किसी शहर को खोलें: तारीख़ें, स्थान, वक्ता और तस्वीरें।" : "Every stop since Patna 2022. Open a city for its dates, venue, speakers and photos."}</p>
        </div>
      </div>
      <div class="route" data-route>
        <svg class="route__line" aria-hidden="true"><path class="route__track" /><path class="route__ink" /></svg>
        <ol class="route__stops">
          {route.map((e, i) => {
            const cover = coverFor(e.slug);
            const live = nextEdition?.slug === e.slug;
            return (
              <li class:list={["stop", live && "is-live"]} style={stopStyle(i)}>
                <a class="stop__card" href={localePath(lang, `/editions/${e.slug}/`)}>
                  <span class="stop__pin" aria-hidden="true">{i + 1}</span>
                  <span class="stop__photo" aria-hidden="true">
                    {cover ? <img src={cover.src} alt="" loading="lazy" decoding="async" style={`object-position:${focusOf(cover)}`} /> : <Landmark slug={e.slug} class="stop__art" />}
                  </span>
                  <span class="stop__body">
                    <span class="stop__year">{e.year}{live && <i>{hi ? "आगामी" : "Upcoming"}</i>}</span>
                    <b class="stop__city">{e.city[lang]}</b>
                    <span class="stop__when">{formatRange(e, lang)}</span>
                    {e.venue && <span class="stop__venue">{e.venue[lang].split(",")[0]}</span>}
                  </span>
                </a>
              </li>
            );
          })}
          <li class="stop stop--invite" style={stopStyle(route.length)}>
            <a class="stop__card" href={`mailto:${org.email}?subject=${encodeURIComponent(hi ? "हमारे शहर में किताब उत्सव" : "Kitab Utsav in our city")}`}>
              <span class="stop__pin" aria-hidden="true">?</span>
              <span class="stop__body">
                <span class="stop__year">{hi ? "अगला पड़ाव" : "Next stop"}</span>
                <b class="stop__city">{hi ? "आपका शहर?" : "Your city?"}</b>
                <span class="stop__when">{hi ? "संस्थान, कॉलेज या साहित्यिक समूह हैं? हमें लिखें, उत्सव आपके शहर आ सकता है।" : "An institution, college or literary group? Write to us and the festival could come to your city."}</span>
                <span class="btn btn--ink btn--sm stop__go">{hi ? "हमें लिखें" : "Write to us"} <Icon name="arrowUpRight" size={16} /></span>
              </span>
            </a>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section anchor ab-gallery" id="gallery" aria-labelledby="gallery-h">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{hi ? "गैलरी" : "Gallery"}</p>
          <h2 class="h2" id="gallery-h">{hi ? "शहर दर शहर, तस्वीरों में" : "City by city, in pictures"}</h2>
          <p class="lead">{hi ? `${totalPhotos} तस्वीरें, ${withPhotos.length} संस्करण। कोई एल्बम खोलें; बड़ी तस्वीर पर टैप करें तो पूरी स्क्रीन पर।` : `${totalPhotos} photos from ${withPhotos.length} editions. Open an album; tap the big photo to see it full screen.`}</p>
        </div>
      </div>
      <div class="albums-wrap" data-albums>
        <div class="albums" role="tablist" aria-label={hi ? "एल्बम चुनें" : "Choose an album"}>
          {withPhotos.map((e, i) => {
            const pics = galleryFor(e.slug);
            const cover = coverFor(e.slug)!;
            const stack = [cover, ...pics.filter((p) => p.src !== cover.src)].slice(0, 3);
            return (
              <button type="button" class="album" role="tab" id={`gt-${e.slug}`} aria-controls={`gp-${e.slug}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                <span class="album__stack" aria-hidden="true">
                  {[...stack].reverse().map((p, k) => <span class={`album__p album__p--${stack.length - 1 - k}`}><img src={p.src} alt="" loading="lazy" decoding="async" /></span>)}
                </span>
                <span class="album__label"><b>{e.city[lang]}</b> {e.year}</span>
                <span class="album__n">{hi ? `${pics.length} तस्वीरें` : `${pics.length} photos`}</span>
              </button>
            );
          })}
        </div>
        {withPhotos.map((e, i) => {
          const pics = galleryFor(e.slug);
          const first = pics[0];
          return (
            <div class="alb-panel" role="tabpanel" id={`gp-${e.slug}`} aria-labelledby={`gt-${e.slug}`} hidden={i !== 0}>
              <div class="alb-head">
                <p class="alb-head__t"><b>{hi ? `किताब उत्सव ${e.city.hi} ${e.year}` : `Kitab Utsav ${e.city.en} ${e.year}`}</b> · {formatRange(e, lang)}{e.venue && ` · ${e.venue[lang].split(",")[0]}`}</p>
                <a class="link-more" href={localePath(lang, `/editions/${e.slug}/`)}>{s.exploreDetails}</a>
              </div>
              <div class="alb-stage" tabindex="-1">
                <button type="button" class="alb-feature" aria-label={hi ? "पूरी स्क्रीन पर देखें" : "View full screen"}>
                  <img src={first.src} alt={first.caption[lang]} decoding="async" loading="lazy" />
                  <span class="alb-feature__zoom" aria-hidden="true"><Icon name="search" /></span>
                </button>
                <button type="button" class="alb-arrow alb-prev" aria-label={hi ? "पिछली तस्वीर" : "Previous photo"}><Icon name="arrowLeft" /></button>
                <button type="button" class="alb-arrow alb-next" aria-label={hi ? "अगली तस्वीर" : "Next photo"}><Icon name="arrowRight" /></button>
              </div>
              <p class="alb-cap" aria-live="polite">
                <span class="alb-cap__text">{first.caption[lang]}</span>
                <span class="alb-cap__meta"><span class="alb-cap__credit">{first.credit && <>{hi ? "फ़ोटो: " : "Photo: "}{first.href ? <a href={first.href} target="_blank" rel="noopener">{first.credit}</a> : first.credit}</>}</span><span class="alb-cap__n">1 / {pics.length}</span></span>
              </p>
              <div class="alb-strip">
                <ul>
                  {pics.map((p, k) => (
                    <li>
                      <button type="button" class="alb-thumb" aria-label={`${k + 1}: ${p.caption[lang]}`} aria-current={k === 0 ? "true" : "false"} data-src={p.src} data-cap={p.caption[lang]} data-credit={p.credit ?? ""} data-href={p.href ?? ""}>
                        <img src={p.src} alt="" loading="lazy" decoding="async" />
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Base>
