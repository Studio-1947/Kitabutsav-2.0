---
/**
 * Home page (bold theme): loud colour fields, chunky display type, pill rows and wavy section
 * edges. The header sits inside the hero box; everything is driven by the data files.
 */
import Base from "../layouts/Base.astro";
import BoldHeader from "../components/BoldHeader.astro";
import Icon from "../components/Icon.astro";
import Bunting from "../components/Bunting.astro";
import Landmark from "../components/Landmark.astro";
import Wave from "../components/Wave.astro";
import { coverFor, focusOf } from "../data/gallery";
import { bookSeatUrl, org } from "../site.config";
import { editions, featuredEdition as fe, nextEdition } from "../data/editions";
import { allSpeakers, festivalTotals, tagline } from "../data/speakers";
import { partners } from "../data/partners";
import { formatRange, localePath, t, type Lang } from "../i18n";
import { eventLd } from "../lib/schema";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const hi = lang === "hi";
const L = (p: string) => localePath(lang, p);
const up = !!nextEdition;
const seat = bookSeatUrl ?? L(`/editions/${fe.slug}/`);
const altHref = localePath(hi ? "en" : "hi", "/");

const byDate = [...editions].sort((a, b) => (b.start ?? `${b.year}`).localeCompare(a.start ?? `${a.year}`));
const rows = byDate.slice(0, 6);
const covers = rows.map((e) => coverFor(e.slug));
const tones = ["blue", "saffron", "navy", "sand", "red", "sky"] as const;

const headline = ["gulzar", "javed-akhtar", "geetanjali-shree", "piyush-mishra", "raghubir-yadav", "alok-dhanwa", "mridula-garg"]
  .map((slug) => allSpeakers.find((p) => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => !!p);

/** Decorative barcode for a ticket stub, the same for the same edition on every build. */
const barcode = (slug: string) => {
  let h = 7;
  const bars: [number, number][] = [];
  for (let x = 0; x < 58; ) {
    for (const ch of slug) h = (h * 31 + ch.charCodeAt(0) + x) % 9973;
    const w = 1 + (h % 3);
    bars.push([x, w]);
    x += w + 1 + ((h >> 3) % 2);
  }
  return bars;
};

// Letters floating around the manifesto: [akshara, x%, y%, size rem, depth, bob seconds, colour]
const floaters = ([
  ["क", 6, 18, 5.5, 1.4, 7, "navy"], ["ता", 88, 14, 4.2, -1, 8.5, "red"], ["ब", 14, 74, 3.6, -1.6, 6.5, "cream"],
  ["उ", 80, 70, 5, 1.2, 9, "navy"], ["त्स", 3, 46, 3, .8, 7.5, "red"], ["व", 93, 44, 3.4, -.9, 6, "cream"],
  ["प", 30, 8, 2.6, 1.8, 8, "cream"], ["ढ़", 68, 90, 3, -1.3, 7, "red"], ["सा", 24, 92, 2.4, 1, 9.5, "navy"],
  ["थ", 72, 6, 2.6, -1.7, 6.8, "navy"],
] as const).map(([g, x, y, s, d, b, c]) => ({ g, x, y, s, d, b, c }));

// Everyone else who has been on stage, in two rows that drift in opposite directions.
const others = allSpeakers.filter((p) => !headline.includes(p)).map((p) => p.name[lang]);
const half = Math.ceil(others.length / 2);
const marqueeRows = [others.slice(0, half), others.slice(half)];

const formats = hi
  ? ["लेखक से मुलाक़ात", "काव्य-पाठ", "लोकार्पण", "परिचर्चा", "पुस्तक प्रदर्शनी", "दास्तानगोई", "कार्यशाला", "बाल-साहित्य", "हस्ताक्षर"]
  : ["Author meets", "Poetry", "Book launches", "Conversations", "Book exhibition", "Dastangoi", "Workshops", "Children's books", "Signings"];

const title = hi
  ? `किताब उत्सव ${fe.year} | राजकमल प्रकाशन समूह का पुस्तक उत्सव`
  : `Kitab Utsav ${fe.year} | Rajkamal Prakashan's Hindi Book Festival`;
const description = hi
  ? `किताब उत्सव: किताबों, पाठकों और लेखकों के संवाद का उत्सव। ${up ? `राजकमल प्रकाशन समूह के इस उत्सव का अगला पड़ाव ${fe.city.hi}, ${formatRange(fe, "hi")}।` : `हाल का पड़ाव ${fe.city.hi}, ${formatRange(fe, "hi")}; अगले शहर की घोषणा जल्द।`} पाठ, बातचीत, चर्चा, लोकार्पण और पुस्तक प्रदर्शनी।`
  : `Kitab Utsav is Rajkamal Prakashan's five-day Hindi book and literature festival. ${up ? `Next stop: ${fe.city.en}, ${formatRange(fe, "en")}.` : `Most recently in ${fe.city.en}, ${formatRange(fe, "en")}; next city announcing soon.`} Readings, conversations, book launches and a book exhibition.`;
const heroEv = up ? eventLd(fe, lang, Astro.site!, "/og/kitab-utsav.jpg") : null;
const jsonLd = heroEv ? [heroEv] : [];
---

<Base lang={lang} route="/" title={title} description={description} jsonLd={jsonLd} home>
    <!-- HERO -->
    <section class="bhero">
      <BoldHeader lang={lang} altHref={altHref} />
      <Bunting />
      <div class="hero__clouds" aria-hidden="true">
        <img class="cloud cloud--a" src="/brand/cloud-1.svg" alt="" width="278" height="120" />
        <img class="cloud cloud--b" src="/brand/cloud-5.svg" alt="" width="288" height="128" />
        <img class="cloud cloud--d" src="/brand/cloud-12.svg" alt="" width="182" height="111" />
        <img class="cloud cloud--e" src="/brand/cloud-3.svg" alt="" width="197" height="115" />
      </div>
      <div class="hero__foot">
        <div class="hero__lockup">
          <img class="cloud hero__titlecloud" src="/brand/cloud-3.svg" alt="" aria-hidden="true" width="197" height="115" />
          <h1 class="hero__title">
            <span class="hero__brand">{hi ? "किताब उत्सव" : "Kitab Utsav"}</span>
            <span class="hero__cityname">{fe.city[lang]}</span>
          </h1>
          <p class="hero__when">{formatRange(fe, lang)}</p>
        </div>
        <div class="hero__ctas">
          <a class="btn btn--red" href={seat}>{s.bookSeat}<Icon name="arrowUpRight" size={20} /></a>
          <a class="btn btn--line btn--line-dark" href={L("/programme/")}>{s.upcomingEvents}</a>
        </div>
      </div>
      <img class="hero__skyline" src="/brand/mumbai-skyline.svg" alt="" aria-hidden="true" width="785" height="168" />
      <img class="hero__blob" src="/brand/hero-element.svg" alt="" aria-hidden="true" width="872" height="538" />
    </section>

    <!-- EDITION PILLS -->
    <section class="stack" aria-label={hi ? "संस्करण" : "Editions"}>
      <div class="ecards">
        {rows.map((e, i) => (
          <a class:list={["ecard", i === 0 && "ecard--lead"]} href={L(`/editions/${e.slug}/`)}>
            <span class:list={["tile", `tile--${tones[i % tones.length]}`, covers[i] && "tile--photo"]} aria-hidden="true">
              {covers[i] ? (
                <img class="tile__photo" src={covers[i]!.src} alt="" loading={i < 2 ? "eager" : "lazy"} decoding="async" width={covers[i]!.w} height={covers[i]!.h} style={`object-position:${focusOf(covers[i]!)}`} />
              ) : (
                <Landmark slug={e.slug} class="tile__art" />
              )}
              <span class="tile__yr">{e.year}</span>
            </span>
            <span class="ecard__body">
              <h2 class="cap__t">{e.city[lang]} <small>{e.year}</small></h2>
              <span class="cap__d">{formatRange(e, lang)}{e.venue ? ` · ${e.venue[lang].split(",")[0]}` : ""}</span>
              <span class="btn btn--ink btn--sm">{hi ? "देखें" : "Explore"}</span>
            </span>
          </a>
        ))}
      </div>
      <a class="more" href={L("/about/#editions")}>{hi ? "सभी 16 संस्करण" : "All 16 editions"} →</a>
    </section>

    <!-- MANIFESTO -->
    <section class="mani">
      <Wave seed={1} />
      <div class="mani__blob" aria-hidden="true"></div>
      <div class="mani__letters" aria-hidden="true">
        {floaters.map((f) => <span lang="hi" style={`left:${f.x}%;top:${f.y}%;--fs:${f.s}rem;--depth:${f.d};--bob:${f.b}s;--c:var(--${f.c})`}>{f.g}</span>)}
      </div>
      <div class="mani__in">
        <p class="kick">{hi ? "राजकमल प्रकाशन समूह का घूमता पुस्तक उत्सव" : "Rajkamal Prakashan's travelling book festival"}</p>
        <h2 class="mega">{tagline[lang]}</h2>
        <ul class="btotals">
          {festivalTotals.map((x) => <li><b>{x.value}</b> {x.label[lang]}</li>)}
        </ul>
        <a class="btn btn--ink" href={L("/about/")}>{hi ? "हमारी कहानी" : "Our story"}</a>
      </div>
    </section>

    <!-- AGENDA -->
    <section class="agenda">
      <Wave seed={2} />
      <h2 class="big">{hi ? "कब, कहाँ" : "When & where"}</h2>
      <ol class="tix">
        {byDate.slice(0, 5).map((e, i) => {
          const live = nextEdition?.slug === e.slug;
          const cover = coverFor(e.slug);
          return (
            <li class:list={["tix__item", live && "is-live"]} style={`--tilt:${i % 2 ? .6 : -.6}deg`}>
              <a class="tix__card" href={live ? seat : L(`/editions/${e.slug}/`)}>
                <span class="tix__photo" aria-hidden="true">
                  {cover ? <img src={cover.src} alt="" loading="lazy" decoding="async" width={cover.w} height={cover.h} style={`object-position:${focusOf(cover)}`} /> : <Landmark slug={e.slug} class="tix__art" />}
                </span>
                <span class="tix__main">
                  <span class="tix__kick">{hi ? "किताब उत्सव · प्रवेश" : "Kitab Utsav · Admit one"}</span>
                  <b class="tix__city">{e.city[lang]}</b>
                  <span class="tix__state">{e.state[lang]}</span>
                  <span class="tix__venue">{e.venue ? e.venue[lang].split(",")[0] : (hi ? "स्थान की घोषणा जल्द" : "Venue to be announced")}</span>
                </span>
                <span class="tix__stub">
                  <span class="tix__date">{formatRange(e, lang, true)}</span>
                  <span class="tix__tag">{live && <i class="tix__dot" aria-hidden="true"></i>}{live ? (hi ? "आगामी" : "Upcoming") : (hi ? "सम्पन्न" : "Past")}</span>
                  <span class="tix__go">{live ? <>{s.bookSeat}<Icon name="arrowUpRight" size={16} /></> : <>{hi ? "झलकियाँ" : "Highlights"} →</>}</span>
                  <svg class="tix__code" viewBox="0 0 60 14" preserveAspectRatio="none" aria-hidden="true">{barcode(e.slug).map(([x, w]) => <rect x={x} width={w} height="14" />)}</svg>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
      <a class="under" href={L("/programme/")}>{s.upcomingEvents}</a>
    </section>

    <!-- NAMES -->
    <section class="names">
      <Wave seed={3} />
      <p class="kick">{hi ? "मंच पर अब तक" : "On our stage so far"}</p>
      <ul class="names__list">
        {headline.map((p, i) => (
          <li style={`--r:${(i % 3) - 1}deg`}>
            <span class="names__row">
              <a href={L(`/resources/#${p.slug}`)}><span>{p.name[lang]}</span></a>
              <button type="button" class="names__more" aria-expanded="false" aria-controls={`nm-${p.slug}`} aria-label={hi ? `${p.name.hi} के बारे में` : `About ${p.name.en}`}><i aria-hidden="true"></i></button>
            </span>
            <div class="names__card" id={`nm-${p.slug}`} hidden>
              <p class="names__role">{p.role[lang]}</p>
              {p.appearances && (
                <ul class="names__at" aria-label={hi ? "किताब उत्सव में" : "At Kitab Utsav"}>
                  {p.appearances.map((a) => <li>{a.edition ? <a href={L(`/editions/${a.edition}/`)}>{a.city[lang]} {a.year}</a> : <span>{a.city[lang]} {a.year}</span>}</li>)}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
      <div class="marquee" aria-hidden="true">
        {marqueeRows.map((row) => (
          <div class="marquee__row">{[...row, ...row].map((n) => <span class="marquee__name">{n}</span>)}</div>
        ))}
      </div>
      <a class="btn btn--cream" href={L("/resources/")}>{hi ? `सभी ${allSpeakers.length} नाम` : `All ${allSpeakers.length} names`} →</a>
    </section>

    <!-- FORMATS -->
    <section class="formats">
      <Wave seed={4} />
      <h2 class="big">{hi ? "उत्सव में क्या-क्या" : "What happens"}</h2>
      <div class="ticker" aria-hidden="true">
        <div class="ticker__t">{[...formats, ...formats].map((f, i) => <span class={`bsticker s${i % 5}`}>{f}</span>)}</div>
      </div>
      <ul class="sr">{formats.map((f) => <li>{f}</li>)}</ul>
      <div class="invite">
        <div>
          <h3 class="invite__t">{hi ? "उत्सव को अपने शहर बुलाएँ" : "Bring the festival to your city"}</h3>
          <p>{hi ? "संस्थान, कॉलेज या साहित्यिक समूह हैं? हमें लिखें, अगला पड़ाव आपका शहर हो सकता है।" : "An institution, college or literary group? Write to us; your city could be the next stop."}</p>
        </div>
        <a class="btn btn--ink btn--plane" href={`mailto:${org.email}?subject=${encodeURIComponent("Kitab Utsav in our city")}`}>
          <svg class="plane" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 11.5 21.5 3 17 21l-5.5-6.2L2 11.5Z" /><path d="M21.5 3 11.5 14.8V20l2.8-3" /></svg>
          {hi ? "हमें लिखें" : "Write to us"}
        </a>
      </div>
    </section>

    <!-- PARTNERS -->
    <section class="bpartners">
      <h2 class="big big--light">{hi ? "साथ चलने वाले" : "Our partners"}</h2>
      <ul class="logos">
        {partners.slice(0, 12).map((p) => <li><img src={p.logo} alt={p.name[lang]} /></li>)}
      </ul>
      <a class="under under--light" href={L("/partners/")}>{hi ? `सभी ${partners.length} साथी` : `All ${partners.length} partners`}</a>
    </section>
</Base>

