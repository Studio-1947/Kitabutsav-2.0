---
import Icon from "./Icon.astro";
import { t, localePath, type Lang } from "../i18n";
import { org, festivalSocial } from "../site.config";
import { featuredEdition, nextEdition } from "../data/editions";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const L = (p: string) => localePath(lang, p);
const hi = lang === "hi";
---
<footer class="site-footer site-footer--short">
  <div class="footer-ripple" aria-hidden="true"><span></span><span></span><span></span><i></i></div>

  <div class="footer-main">
    <div class="footer-news" id="newsletter">
      <div>
        <h4>{s.newsletterTitle}</h4>
        <p>{s.newsletterText}</p>
      </div>
      <div>
        <form class="newsletter" data-newsletter data-email={org.email} data-thanks={s.newsletterThanks}>
          <label class="sr-only" for="nl-email">{s.newsletterPlaceholder}</label>
          <input id="nl-email" type="email" name="email" required autocomplete="email" placeholder={s.newsletterPlaceholder} />
          <button class="btn btn--primary" type="submit">{s.newsletterBtn}</button>
        </form>
        <p class="newsletter-note" aria-live="polite"></p>
      </div>
    </div>
    <div class="footer-inner footer-inner--short">
      <div class="footer-brand">
        <img class="footer-mark footer-mark--ku" src="/brand/kitab-utsav-logo.svg" alt={s.siteNameFull} width="84" height="84" loading="lazy" />
        <p class="footer-tagline">{s.tagline}</p>
        <ul class="footer-contact-list">
          <li><span class="fc-icon" aria-hidden="true">✉️</span> <a href={`mailto:${org.email}?subject=${encodeURIComponent("Kitab Utsav")}`}>{org.email}</a></li>
        </ul>
        <div class="social-row">
          {festivalSocial.map((x) => (
            <a href={x.url} target="_blank" rel="noopener noreferrer" aria-label={`${s.siteName} on ${x.name}`}><Icon name={x.name} /></a>
          ))}
        </div>
      </div>

      <div class="footer-stack">
        <div>
          <h4>{s.siteName}</h4>
          <ul>
            <li><a href={L("/about/")}>{s.nav.about}</a></li>
            <li><a href={L("/editions/")}>{s.nav.editions}</a></li>
            <li><a href={L("/programme/")}>{s.nav.programme}</a></li>
            <li><a href={L("/resources/")}>{hi ? "लेखक" : "Authors"}</a></li>
            <li><a href={L("/gallery/")}>{hi ? "गैलरी" : "Gallery"}</a></li>
            <li><a href={L("/press/")}>{hi ? "मीडिया" : "Press"}</a></li>
            <li><a href={L("/visit/")}>{s.nav.visit}</a></li>
            <li><a href={L("/faq/")}>{s.nav.faq}</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-stack">
        <div>
          <h4>{hi ? "जुड़ें" : "Get Involved"}</h4>
          <ul>
            {nextEdition && <li><a href={`/ics/${nextEdition.slug}.ics`} download>{s.addToCal}</a></li>}
            <li><a href="#newsletter">{s.newsletterTitle}</a></li>
            <li><a href={`mailto:${org.email}?subject=${encodeURIComponent(hi ? "हमारे शहर में किताब उत्सव" : "Kitab Utsav in our city")}`}>{hi ? "किताब उत्सव बुलाएँ" : "Invite Kitab Utsav"}</a></li>
            <li><a href={org.url} target="_blank" rel="noopener">{hi ? "राजकमल प्रकाशन समूह" : "By Rajkamal Prakashan Samuh"}</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-art" aria-hidden="true">
        <img src="/brand/hero-element.svg" alt="" width="872" height="538" loading="lazy" />
      </div>
    </div>

    <div class="footer-divider" aria-hidden="true"></div>

    <div class="footer-bottom">
      <p class="footer-copy">{s.copyright}</p>
      <p class="footer-credit">{s.designedBy} <a href="https://1947.io" target="_blank" rel="noopener">Studio 1947</a></p>
    </div>

    <button class="scroll-top" type="button" aria-label={s.scrollTop}><i>→</i></button>
  </div>
</footer>
