---
import Icon from "./Icon.astro";
import { t, localePath, routeOf, type Lang } from "../i18n";
import { org, bookSeatUrl } from "../site.config";
import { nextEdition } from "../data/editions";

interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const s = t(lang);
const route = routeOf(Astro.url.pathname);
const L = (p: string) => localePath(lang, p);

const nav = [
  { href: L("/editions/"), label: s.nav.editions, match: "/editions/" },
  { href: L("/programme/"), label: s.nav.programme, match: "/programme/" },
  { href: L("/resources/"), label: lang === "hi" ? "लेखक" : "Authors", match: "/resources/" },
  { href: L("/gallery/"), label: lang === "hi" ? "गैलरी" : "Gallery", match: "/gallery/" },
  { href: L("/about/"), label: s.nav.about, match: "/about/" },
  { href: L("/visit/"), label: s.nav.visit, match: "/visit/" },
  { href: L("/faq/"), label: s.nav.faq, match: "/faq/" },
];
const icsHref = nextEdition ? `/ics/${nextEdition.slug}.ics` : null;
// Between editions there is no seat to book: the CTA collects emails for the next one instead.
const cta = nextEdition
  ? { href: bookSeatUrl ?? L(`/editions/${nextEdition.slug}/`), label: s.bookSeat, ext: !!bookSeatUrl }
  : { href: "#newsletter", label: lang === "hi" ? "ख़बर पाएँ" : "Get updates", ext: false };
---
<header class="site-header" id="siteHeader">
  <div class="header-top">
    <a class="logo" href={L("/")} aria-label={`${s.siteName}, ${s.by}`}>
      <span class="logo-wordmark">किताब उत्सव</span>
    </a>

    <nav class="header-nav-main" aria-label={lang === "hi" ? "मुख्य नेविगेशन" : "Main navigation"}>
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={route.startsWith(n.match) ? "page" : undefined}>{n.label}</a></li>
        ))}
        <li><a class="nav-ext" href={org.url} target="_blank" rel="noopener">{s.nav.shop}<Icon name="ext" /></a></li>
      </ul>
    </nav>

    <div class="header-icons">
      <a class="pill-btn pill-btn--lang" href={altHref} hreflang={lang === "hi" ? "en" : "hi"} lang={lang === "hi" ? "en" : "hi"} aria-label={s.langSwitch} title={s.langSwitch}>{s.langShort}</a>
      {icsHref && (
        <a class="pill-btn pill-btn--cal" href={icsHref} download aria-label={s.addToCal} title={s.addToCal}>
          <Icon name="calendar" size={17} class="pill-ic" />
        </a>
      )}
      <button type="button" class="pill-btn pill-btn--burger" aria-label={s.openMenu} aria-expanded="false" aria-controls="mobileMenu"><span class="burger-lines" aria-hidden="true"><i></i><i></i><i></i></span></button>
    </div>

    <a class="btn btn--primary header-cta" href={cta.href} {...(cta.ext ? { target: "_blank", rel: "noopener" } : {})}>{cta.label}</a>
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    <ul class="mobile-menu__links">
      {nav.map((n) => <li><a href={n.href}>{n.label}<span aria-hidden="true">→</span></a></li>)}
      <li><a href={org.url} target="_blank" rel="noopener">{s.nav.shop}<span aria-hidden="true">↗</span></a></li>
    </ul>
    <div class="mobile-menu__actions">
      <a href={altHref} class="mobile-menu__action"><Icon name="lang" /><span>{s.langSwitch}</span></a>
      {icsHref && <a href={icsHref} download class="mobile-menu__action"><Icon name="calendar" /><span>{s.addToCal}</span></a>}
    </div>
  </div>
</header>
