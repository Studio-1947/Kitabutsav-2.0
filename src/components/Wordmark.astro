---
/**
 * Typographic Kitab Utsav lockup in the campaign colours (blue किताब, red उत्सव, arched
 * "राजकमल ✺ साथ जुड़ें, साथ पढ़ें"). The open-book mark is a generic stand-in, not the official
 * emblem: set `festivalLogo` in site.config.ts to use the real logo file instead.
 */
import { festivalLogo } from "../site.config";
import type { Lang } from "../i18n";
interface Props { lang: Lang; id?: string }
const { lang, id = "wm" } = Astro.props;
const title = lang === "hi" ? "किताब उत्सव: राजकमल, साथ जुड़ें, साथ पढ़ें" : "Kitab Utsav: Rajkamal, come together, read together";
const rays = [-62, -40, -18, 18, 40, 62].map((a) => {
  const r = (a * Math.PI) / 180;
  const cx = 280, cy = 238;
  return { x1: cx + Math.sin(r) * 104, y1: cy - Math.cos(r) * 104, x2: cx + Math.sin(r) * 130, y2: cy - Math.cos(r) * 130 };
});
---
{festivalLogo ? (
  <img class="wordmark-img" src={festivalLogo} alt={title} width="460" height="460" />
) : (
  <svg class="wordmark" viewBox="0 0 560 540" role="img" aria-label={title}>
    <defs><path id={`${id}-arc`} d="M62 258 A218 218 0 0 1 498 258" /></defs>
    <text class="arc" text-anchor="middle">
      <textPath href={`#${id}-arc`} startOffset="50%">
        <tspan class="t-red">राजकमल</tspan><tspan class="t-orange"> ✺ </tspan><tspan class="t-blue">साथ जुड़ें, साथ पढ़ें</tspan>
      </textPath>
    </text>
    {rays.map((r) => <line class="rays" x1={r.x1} y1={r.y1} x2={r.x2} y2={r.y2} />)}
    <path class="book" d="M280 236c-30-26-70-34-112-26l12-58c40-6 76 6 100 30 24-24 60-36 100-30l12 58c-42-8-82 0-112 26z" />
    <path d="M280 182v52" stroke="#fff" stroke-width="5" stroke-linecap="round" />
    <text class="w-kitab" x="34" y="398">किताब</text>
    <text class="w-utsav" x="196" y="522">उत्सव</text>
  </svg>
)}
