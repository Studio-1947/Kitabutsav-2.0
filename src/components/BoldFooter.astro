---
/**
 * Site footer, "closing chapter": a big Book my seat call for the next edition (with a live
 * countdown once its dates are set), then a back-cover panel with the page links, contact and a
 * giant किताब उत्सव wordmark whose letters fill in as it scrolls into view.
 * The Hindi letters that swirl round the cursor (letters.js) still target `.foot`.
 */
import Icon from "./Icon.astro";
import { t, localePath, formatRange, type Lang } from "../i18n";
import { org, festivalSocial, bookSeatUrl } from "../site.config";
import { nextEdition, featuredEdition } from "../data/editions";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const hi = lang === "hi";
const L = (p: string) => localePath(lang, p);
const e = nextEdition ?? featuredEdition;
const seat = bookSeatUrl ?? L(`/editions/${e.slug}/`);
const invite = `mailto:${org.email}?subject=${encodeURIComponent(hi ? "हमारे शहर में किताब उत्सव" : "Kitab Utsav in our city")}`;
const dated = !!(nextEdition?.start && nextEdition.end);
const startIso = dated ? `${nextEdition!.start}T${nextEdition!.startTime ?? "11:00"}:00+05:30` : "";
const endIso = dated ? `${nextEdition!.end}T${nextEdition!.endTime ?? "20:00"}:00+05:30` : "";

const links = [
  { href: L("/about/"), label: hi ? "परिचय" : "About" },
  { href: L("/programme/"), label: s.nav.programme },
  { href: L("/resources/"), label: hi ? "लेखक" : "Authors" },
  { href: L("/partners/"), label: s.nav.partners },
  { href: L("/press/"), label: hi ? "मीडिया" : "Press" },
  { href: L("/visit/"), label: s.nav.visit },
  { href: L("/faq/"), label: s.nav.faq },
];
// Hindi stays as two whole words so each keeps its unbroken headline (shirorekha); English is
// spread letter by letter.
const word = hi ? ["किताब", " ", "उत्सव"] : [..."KITAB UTSAV"];
---
<footer class="foot foot--chapter">
  <a class="fend" href={seat}>
    <span class="fend__top">
      <span class="fend__kick">{nextEdition ? (hi ? "अगला पड़ाव" : "Next stop") : (hi ? "पिछला पड़ाव" : "Last stop")}</span>
      <span class="fend__where">{hi ? `किताब उत्सव ${e.city.hi}` : `Kitab Utsav ${e.city.en}`} · {formatRange(e, lang)}</span>
    </span>
    <span class="fend__cta">{s.bookSeat}</span>
    {dated ? (
      <span class="fend__count" data-countdown data-start={startIso} data-end={endIso} aria-label={hi ? "उत्सव शुरू होने में" : "Time until the festival opens"}>
        <span><b data-unit="d">00</b><small>{s.days}</small></span>
        <span><b data-unit="h">00</b><small>{s.hours}</small></span>
        <span><b data-unit="m">00</b><small>{s.minutes}</small></span>
      </span>
    ) : (
      <span class="fend__soon">{hi ? "तारीख़ें जल्द" : "Dates soon"}</span>
    )}
    <span class="fend__arrow" aria-hidden="true"><Icon name="arrowUpRight" /></span>
  </a>

  <div class="fcover">
    <nav class="fcover__nav" aria-label={hi ? "फ़ुटर" : "Footer"}>
      {links.map((l) => <a href={l.href}><span>{l.label}</span><Icon name="arrowRight" /></a>)}
    </nav>
    <div class="fcover__contact">
      <h3>{hi ? "राजकमल प्रकाशन समूह" : "Rajkamal Prakashan Samuh"}</h3>
      <p>{org.address.streetAddress}<br />{org.address.addressLocality} {org.address.postalCode}</p>
      <ul class="fcover__icons">
        <li><a href={`mailto:${org.email}?subject=${encodeURIComponent("Kitab Utsav")}`} aria-label={`${hi ? "ईमेल" : "Email"}: ${org.email}`} title={org.email}><Icon name="mail" /></a></li>
        <li><a href={`tel:${org.phones[0].tel}`} aria-label={`${hi ? "फ़ोन" : "Phone"}: ${org.phones[0].label}`} title={org.phones[0].label}><Icon name="phone" /></a></li>
        {festivalSocial.map((x) => <li><a href={x.url} target="_blank" rel="noopener" aria-label={`${x.name} ${x.handle}`} title={x.handle}><Icon name={x.name} /></a></li>)}
      </ul>
      <p class="fcover__lines"><a href={`mailto:${org.email}`}>{org.email}</a><br /><a href={`tel:${org.phones[0].tel}`}>{org.phones[0].label}</a></p>
      <div class="fcover__pills">
        <a class="fpill" href={invite}>{hi ? "किताब उत्सव बुलाएँ" : "Invite Kitab Utsav"}</a>
        <a class="fpill" href={org.url} target="_blank" rel="noopener">{s.nav.shop} ↗</a>
        {dated && <a class="fpill" href={`/ics/${nextEdition!.slug}.ics`} download>{s.addToCal}</a>}
      </div>
    </div>
    <p class="fword" aria-hidden="true" lang={hi ? "hi" : "en"}>
      {word.map((g, i) => (g === " " ? <span class="fword__gap"> </span> : <span class="fword__g" style={`--gi:${i}`}>{g}</span>))}
    </p>
  </div>

  <div class="foot__bottom">
    <p>{s.copyright}</p>
    <p>{s.designedBy} <a href="https://1947.io" target="_blank" rel="noopener">Studio 1947</a></p>
  </div>
</footer>
