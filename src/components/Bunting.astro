---
/**
 * Festival bunting across the top of the hero: a round logo medallion hangs in the centre and
 * two strings swag up to the left and two to the right. Flags are round medallions in the festival
 * colours, and carry one Hindi akshara each (किताब उत्सव, राजकमल), reading outward from
 * the centre. Everything sways gently. Coordinates are percentages of the band.
 * Purely decorative (aria-hidden); the motion stops for prefers-reduced-motion.
 */
const seg = new Intl.Segmenter("hi", { granularity: "grapheme" });
const aksharas = (s: string) => [...seg.segment(s.replace(/\s/g, ""))].map((x) => x.segment);

type Pt = [number, number];
const knot: Pt = [50, 60];
// end point on the top edge and how far the string sags below the straight line
const strands: { end: Pt; sag: number; text: string; from: number }[] = [
  { end: [24, -4], sag: 34, text: "किताब उत्सव", from: 0.36 },
  { end: [37, -4], sag: 10, text: "किताब", from: 0.46 },
  { end: [63, -4], sag: 10, text: "उत्सव", from: 0.46 },
  { end: [76, -4], sag: 34, text: "राजकमल", from: 0.38 },
];
const tones = ["red", "saffron", "blue", "yellow", "sky", "sand"];

// quadratic Bézier from the knot to the end, control point pulled down by `sag`
const q = (t: number, a: Pt, c: Pt, b: Pt): Pt => {
  const u = 1 - t;
  return [0, 1].map((k) => u * u * a[k] + 2 * u * t * c[k] + t * t * b[k]) as Pt;
};

const rows = strands.map((s, r) => {
  const ctrl: Pt = [(knot[0] + s.end[0]) / 2, Math.max(knot[1], s.end[1]) + s.sag];
  const glyphs = aksharas(s.text);
  const n = glyphs.length;
  const flags = glyphs.map((g, i) => {
    const t = s.from + ((0.98 - s.from) * (i + 0.5)) / n;
    const [x, y] = q(t, knot, ctrl, s.end);
    return { g, x, y, round: true, tone: tones[(i + r * 2) % tones.length], d: ((i * 37 + r * 11) % 23) / 10, dur: 3.2 + ((i * 13 + r) % 9) / 5 };
  });
  return { flags, path: `M${knot.join(",")} Q${ctrl.join(",")} ${s.end.join(",")}` };
});
const pct = (n: number) => `${n.toFixed(2)}%`;
---
<div class="bunting" aria-hidden="true">
  <svg class="bunting__strings" viewBox="0 0 100 100" preserveAspectRatio="none">
    {rows.map((row) => <path d={row.path} vector-effect="non-scaling-stroke" />)}
  </svg>
  {rows.map((row, r) => (
    <div class:list={["bunting__row", `bunting__row--${r}`]}>
      {row.flags.map((f) => (
        <span
          class:list={["flag", f.round ? "flag--round" : "flag--pennant", `flag--${f.tone}`]}
          style={`left:${pct(f.x)};top:${pct(f.y)};--d:-${f.d}s;--dur:${f.dur.toFixed(2)}s`}
          lang="hi"
        ><b>{f.g}</b></span>
      ))}
    </div>
  ))}
  <span class="flag flag--round flag--logo bunting__knot" style={`left:${pct(knot[0])};top:${pct(knot[1])}`}>
    <img src="/brand/kitab-utsav-logo.svg" alt="" width="46" height="42" />
  </span>
</div>
