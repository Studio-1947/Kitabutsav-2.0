---
/**
 * Festival bunting: strings of flags hanging across the hero and swaying gently as if in a breeze.
 * Flags alternate between pennants and round medallions; each carries one Hindi akshara of
 * "किताब उत्सव" or "राजकमल", with the Kitab Utsav logo on a round flag in between.
 * Purely decorative (aria-hidden); the motion stops for prefers-reduced-motion.
 */
const seg = new Intl.Segmenter("hi", { granularity: "grapheme" });
const aksharas = (s: string) => [...seg.segment(s.replace(/\s/g, ""))].map((x) => x.segment);
const LOGO = "__logo__";

// Each string is a gentle parabola (y in % of the band height) spanning part of the width.
const strings = [
  { items: [...aksharas("किताब उत्सव"), LOGO, ...aksharas("राजकमल")], from: 15, to: 128, until: 97, sag: 100, size: 1 },
];
const tones = ["red", "saffron", "blue", "yellow", "sky", "sand"];

const rows = strings.map((s, r) => {
  const n = s.items.length;
  const flags = s.items.map((g, i) => {
    // flags sit on the visible part of the string (from..until); the curve itself runs from..to
    const x = s.from + (s.until - s.from) * ((i + 0.5) / n);
    const t = (x - s.from) / (s.to - s.from);
    return {
      g,
      logo: g === LOGO,
      round: g === LOGO || i % 2 === 1,
      x,
      y: s.sag * 4 * t * (1 - t),
      tone: tones[(i + r * 3) % tones.length],
      d: ((i * 37 + r * 11) % 23) / 10,
      dur: 3.2 + ((i * 13 + r) % 9) / 5,
    };
  });
  const pts = Array.from({ length: 41 }, (_, k) => {
    const t = k / 40;
    return `${(s.from + (s.to - s.from) * t).toFixed(2)},${(s.sag * 4 * t * (1 - t)).toFixed(2)}`;
  });
  return { ...s, flags, path: `M${pts.join(" L")}` };
});
---
<div class="bunting" aria-hidden="true">
  {rows.map((row, r) => (
    <div class:list={["bunting__row", `bunting__row--${r}`]} style={`--fs:${row.size}`}>
      <svg class="bunting__string" viewBox="0 0 100 100" preserveAspectRatio="none"><path d={row.path} vector-effect="non-scaling-stroke" /></svg>
      {row.flags.map((f) => (
        <span
          class:list={["flag", f.round ? "flag--round" : "flag--pennant", f.logo ? "flag--logo" : `flag--${f.tone}`]}
          style={`left:${f.x.toFixed(2)}%;top:${f.y.toFixed(2)}%;--d:-${f.d}s;--dur:${f.dur.toFixed(2)}s`}
          lang="hi"
        >
          {f.logo ? <img src="/brand/kitab-utsav-logo.svg" alt="" width="40" height="37" /> : <b>{f.g}</b>}
        </span>
      ))}
    </div>
  ))}
</div>
